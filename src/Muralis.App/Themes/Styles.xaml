<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Typography  -->

    <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource MuralisTitleLargeTextStyle}">
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource MuralisBodyTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource MuralisTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource MuralisTitleTextStyle}" />

    <Style x:Key="SectionActionStyle" TargetType="HyperlinkButton">
        <Setter Property="Foreground" Value="{ThemeResource MuralisTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="CardCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource MuralisCaptionTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource MuralisTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--  Surfaces  -->

    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource MuralisSurfaceHighBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource MuralisBorderNormalBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource MuralisRadiusS}" />
    </Style>

    <Style x:Key="LargeCardBorderStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
        <Setter Property="Background" Value="{ThemeResource MuralisGlassHighBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource MuralisRadiusM}" />
        <Setter Property="Shadow" Value="{StaticResource MuralisElevation3Shadow}" />
    </Style>

    <!--  Item containers  -->

    <Style x:Key="WallpaperItemContainerStyle" TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
        <Setter Property="Margin" Value="0,0,12,12" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="WallpaperRowItemContainerStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>

</ResourceDictionary>
