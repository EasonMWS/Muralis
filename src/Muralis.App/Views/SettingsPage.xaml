<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Muralis.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Muralis.Core.Models"
    xmlns:vm="using:Muralis.App.ViewModels"
    Background="Transparent"
    mc:Ignorable="d">

    <ScrollViewer Padding="36,24,36,40" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="880"
            HorizontalAlignment="Left"
            Spacing="10">

            <StackPanel Margin="0,0,0,8">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="{Binding [Settings_Title], Source={StaticResource Loc}}" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="{Binding [Settings_Subtitle], Source={StaticResource Loc}}" />
            </StackPanel>

            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}"
                Severity="Success"
                Visibility="{x:Bind ViewModel.SuccessMessage, Mode=OneWay, Converter={StaticResource NullToVisibility}}" />
            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error"
                Title="{Binding [Common_Error_Title], Source={StaticResource Loc}}"
                Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVisibility}}" />

            <!--  Language  -->
            <TextBlock
                Margin="0,14,0,4"
                Style="{StaticResource SectionTitleStyle}"
                Text="{Binding [Settings_Section_Language], Source={StaticResource Loc}}" />
            <Border Padding="16" Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="20"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE774;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding [Settings_Language_Title], Source={StaticResource Loc}}" />
                        <TextBlock Style="{StaticResource CardCaptionStyle}" Text="{Binding [Settings_Language_Description], Source={StaticResource Loc}}" />
                    </StackPanel>
                    <ComboBox
                        x:Name="LanguageCombo"
                        Grid.Column="2"
                        MinWidth="170"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{Binding [Settings_Language_Title], Source={StaticResource Loc}}"
                        DisplayMemberPath="DisplayName"
                        SelectionChanged="OnLanguageSelectionChanged" />
                </Grid>
            </Border>

            <!--  Appearance  -->
            <TextBlock
                Margin="0,14,0,4"
                Style="{StaticResource SectionTitleStyle}"
                Text="{Binding [Settings_Section_Appearance], Source={StaticResource Loc}}" />
            <Border Padding="16" Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="20"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE790;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding [Settings_Theme_Title], Source={StaticResource Loc}}" />
                        <TextBlock Style="{StaticResource CardCaptionStyle}" Text="{Binding [Settings_Theme_Description], Source={StaticResource Loc}}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="2"
                        VerticalAlignment="Center">
                        <RadioButton
                            Click="OnSystemThemeClick"
                            Content="{Binding [Settings_Theme_System], Source={StaticResource Loc}}"
                            GroupName="ThemeGroup"
                            IsChecked="{x:Bind ViewModel.IsSystemTheme, Mode=OneWay}" />
                        <RadioButton
                            Click="OnLightThemeClick"
                            Content="{Binding [Settings_Theme_Light], Source={StaticResource Loc}}"
                            GroupName="ThemeGroup"
                            IsChecked="{x:Bind ViewModel.IsLightTheme, Mode=OneWay}" />
                        <RadioButton
                            Click="OnDarkThemeClick"
                            Content="{Binding [Settings_Theme_Dark], Source={StaticResource Loc}}"
                            GroupName="ThemeGroup"
                            IsChecked="{x:Bind ViewModel.IsDarkTheme, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Desktop Experience  -->
            <TextBlock
                Margin="0,14,0,4"
                Style="{StaticResource SectionTitleStyle}"
                Text="{Binding [Settings_Section_DesktopExperience], Source={StaticResource Loc}}" />
            <Border Padding="16" Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="20"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE7F4;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding [Settings_DesktopExperience_Title], Source={StaticResource Loc}}" />
                        <TextBlock
                            Style="{StaticResource CardCaptionStyle}"
                            Text="{x:Bind ViewModel.DesktopExperienceStateText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox
                        x:Name="DesktopExperienceCombo"
                        Grid.Column="2"
                        MinWidth="310"
                        SelectionChanged="OnDesktopExperienceSelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DesktopExperienceOption">
                                <StackPanel MaxWidth="360" Spacing="2">
                                    <TextBlock Text="{x:Bind Label}" />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Description}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </Border>

            <!--  Muralis Mode: the experience the dock and the Shelf belong to  -->
            <TextBlock
                Margin="0,14,0,4"
                Style="{StaticResource SectionTitleStyle}"
                Text="{Binding [Settings_Section_MuralisMode], Source={StaticResource Loc}}" />
            <Border Padding="16" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="14">
                    <TextBlock
                        Style="{StaticResource CardCaptionStyle}"
                        Text="{Binding [Settings_Section_MuralisMode_Description], Source={StaticResource Loc}}"
                        TextWrapping="Wrap" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="20"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE7F4;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding [Settings_Dock_Show_Title], Source={StaticResource Loc}}" />
                            <TextBlock
                                Style="{StaticResource CardCaptionStyle}"
                                Text="{Binding [Settings_Dock_Show_Description], Source={StaticResource Loc}}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding [Settings_Dock_Required], Source={StaticResource Loc}}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.IsMuralisMode, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{Binding [Settings_Dock_Show_Title], Source={StaticResource Loc}}"
                            IsEnabled="{x:Bind ViewModel.CanChangeDockVisibility, Mode=OneWay}"
                            IsOn="{x:Bind ViewModel.ShowDock, Mode=TwoWay}"
                            OffContent="{Binding [Common_Off], Source={StaticResource Loc}}"
                            OnContent="{Binding [Common_On], Source={StaticResource Loc}}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!--  Wallpapers  -->
            <TextBlock
                Margin="0,14,0,4"
                Style="{StaticResource SectionTitleStyle}"
                Text="{Binding [Settings_Section_Wallpapers], Source={StaticResource Loc}}" />
            <Border Padding="16" Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="20"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE91B;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding [Settings_DefaultStyle_Title], Source={StaticResource Loc}}" />
                        <TextBlock Style="{StaticResource CardCaptionStyle}" Text="{Binding [Settings_DefaultStyle_Description], Source={StaticResource Loc}}" />
                    </StackPanel>
                    <ComboBox
                        x:Name="FitModeCombo"
                        Grid.Column="2"
                        MinWidth="150"
                        VerticalAlignment="Center"
                        DisplayMemberPath="Label"
                        SelectionChanged="OnFitModeSelectionChanged" />
                </Grid>
            </Border>

            <Border Padding="16" Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="20"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE7E8;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding [Settings_Startup_Title], Source={StaticResource Loc}}" />
                        <TextBlock Style="{StaticResource CardCaptionStyle}" Text="{Binding [Settings_Startup_Description], Source={StaticResource Loc}}" />
                    </StackPanel>
                    <ToggleSwitch
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        IsOn="{x:Bind ViewModel.LaunchAtStartup, Mode=TwoWay}"
                        OffContent="{Binding [Common_Off], Source={StaticResource Loc}}"
                        OnContent="{Binding [Common_On], Source={StaticResource Loc}}" />
                </Grid>
            </Border>

            <!--  Auto rotation  -->
            <Border Padding="16" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="20"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE895;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding [Settings_Rotation_Title], Source={StaticResource Loc}}" />
                            <TextBlock Style="{StaticResource CardCaptionStyle}" Text="{Binding [Settings_Rotation_Description], Source={StaticResource Loc}}" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{Binding [Settings_Rotation_Title], Source={StaticResource Loc}}"
                            IsOn="{x:Bind ViewModel.RotationEnabled, Mode=TwoWay}"
                            OffContent="{Binding [Common_Off], Source={StaticResource Loc}}"
                            OnContent="{Binding [Common_On], Source={StaticResource Loc}}" />
                    </Grid>

                    <ContentControl x:Name="RotationOptionsPanel" HorizontalContentAlignment="Stretch">
                        <Grid ColumnSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource CardCaptionStyle}"
                                Text="{Binding [Settings_Rotation_Interval], Source={StaticResource Loc}}" />
                            <ComboBox
                                x:Name="IntervalCombo"
                                Grid.Column="1"
                                MinWidth="190"
                                AutomationProperties.Name="{Binding [Settings_Rotation_Interval], Source={StaticResource Loc}}"
                                SelectionChanged="OnIntervalSelectionChanged" />

                            <TextBlock
                                Grid.Row="1"
                                Margin="0,10,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource CardCaptionStyle}"
                                Text="{Binding [Settings_Rotation_Source], Source={StaticResource Loc}}" />
                            <ComboBox
                                x:Name="RotationSourceCombo"
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,10,0,0"
                                MinWidth="190"
                                AutomationProperties.Name="{Binding [Settings_Rotation_Source], Source={StaticResource Loc}}"
                                SelectionChanged="OnRotationSourceSelectionChanged" />

                            <TextBlock
                                x:Name="RotationSummaryText"
                                Grid.Row="2"
                                Margin="0,10,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource CardCaptionStyle}"
                                TextTrimming="CharacterEllipsis" />
                            <Button
                                Grid.Row="2"
                                Grid.Column="1"
                                Margin="0,10,0,0"
                                AutomationProperties.Name="{Binding [Settings_Rotation_Choose], Source={StaticResource Loc}}"
                                Click="OnChooseRotationFolderClick"
                                Content="{Binding [Settings_Rotation_Choose], Source={StaticResource Loc}}" />

                            <TextBlock
                                Grid.Row="3"
                                Margin="0,10,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource CardCaptionStyle}"
                                Text="{Binding [Settings_Rotation_ShuffleHint], Source={StaticResource Loc}}" />
                            <Button
                                Grid.Row="3"
                                Grid.Column="1"
                                Margin="0,10,0,0"
                                AutomationProperties.Name="{Binding [Settings_Rotation_ShuffleNow], Source={StaticResource Loc}}"
                                Click="OnShuffleNowClick"
                                Content="{Binding [Settings_Rotation_ShuffleNow], Source={StaticResource Loc}}" />
                        </Grid>
                    </ContentControl>
                </StackPanel>
            </Border>

            <Border Padding="16" Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="20"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE8A7;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding [Settings_Tray_Title], Source={StaticResource Loc}}" />
                        <TextBlock Style="{StaticResource CardCaptionStyle}" Text="{Binding [Settings_Tray_Description], Source={StaticResource Loc}}" />
                    </StackPanel>
                    <ToggleSwitch
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{Binding [Settings_Tray_Title], Source={StaticResource Loc}}"
                        IsOn="{x:Bind ViewModel.CloseToTray, Mode=TwoWay}"
                        OffContent="{Binding [Common_Off], Source={StaticResource Loc}}"
                        OnContent="{Binding [Common_On], Source={StaticResource Loc}}" />
                </Grid>
            </Border>

            <!--  Wallpaper sources  -->
            <TextBlock
                Margin="0,14,0,4"
                Style="{StaticResource SectionTitleStyle}"
                Text="{Binding [Settings_Sources_Title], Source={StaticResource Loc}}" />
            <Border Padding="16" Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="20"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE8B9;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding [Settings_Sources_Default_Title], Source={StaticResource Loc}}" />
                        <TextBlock Style="{StaticResource CardCaptionStyle}" Text="{Binding [Settings_Sources_Default_Description], Source={StaticResource Loc}}" />
                    </StackPanel>
                    <ComboBox
                        x:Name="DefaultSourceCombo"
                        Grid.Column="2"
                        MinWidth="180"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{Binding [Settings_Sources_Default_Title], Source={StaticResource Loc}}"
                        DisplayMemberPath="Name"
                        ItemsSource="{x:Bind ViewModel.DefaultSourceItems}"
                        SelectionChanged="OnDefaultSourceSelectionChanged" />
                </Grid>
            </Border>

            <Border Padding="16,6" Style="{StaticResource CardBorderStyle}">
                <ItemsControl ItemsSource="{x:Bind ViewModel.ProviderSources}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProviderSourceItem">
                            <Grid Padding="0,10" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="18"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="{x:Bind Glyph}" />
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name, Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource CardCaptionStyle}" Text="{x:Bind Description, Mode=OneWay}" />
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        Visibility="{x:Bind NeedsApiKey, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                        <FontIcon
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            Glyph="&#xE7BA;" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource CardCaptionStyle}"
                                            Text="{Binding [Settings_Sources_NeedsKey], Source={StaticResource Loc}}" />
                                        <HyperlinkButton
                                            Padding="0"
                                            Content="{Binding [Settings_Sources_Setup], Source={StaticResource Loc}}"
                                            NavigateUri="{x:Bind SetupUrl}" />
                                    </StackPanel>
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                                    IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                    OffContent="{Binding [Common_Off], Source={StaticResource Loc}}"
                                    OnContent="{Binding [Common_On], Source={StaticResource Loc}}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!--  Displays  -->
            <TextBlock
                Margin="0,14,0,4"
                Style="{StaticResource SectionTitleStyle}"
                Text="{Binding [Settings_Section_Displays], Source={StaticResource Loc}}" />
            <Border Padding="16" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="20"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE7F4;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding [Settings_Displays_Title], Source={StaticResource Loc}}" />
                            <TextBlock Style="{StaticResource CardCaptionStyle}" Text="{x:Bind ViewModel.MonitorCountText, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Monitors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:MonitorInfo">
                                <Grid Margin="36,4,0,0" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind SummaryText}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        MaxWidth="280"
                                        Style="{StaticResource CardCaptionStyle}"
                                        Text="{x:Bind Id}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind Id}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!--  Downloads  -->
            <TextBlock
                Margin="0,14,0,4"
                Style="{StaticResource SectionTitleStyle}"
                Text="{Binding [Settings_Section_Downloads], Source={StaticResource Loc}}" />
            <Border Padding="16" Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="20"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE896;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding [Settings_DownloadFolder_Title], Source={StaticResource Loc}}" />
                        <TextBlock
                            MaxWidth="380"
                            Style="{StaticResource CardCaptionStyle}"
                            Text="{x:Bind ViewModel.DownloadFolder, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind ViewModel.DownloadFolder, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <Button Click="OnOpenDownloadFolderClick" Content="{Binding [Settings_Open], Source={StaticResource Loc}}" />
                        <Button Click="OnChangeDownloadFolderClick" Content="{Binding [Settings_Change], Source={StaticResource Loc}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Storage  -->
            <TextBlock
                Margin="0,14,0,4"
                Style="{StaticResource SectionTitleStyle}"
                Text="{Binding [Settings_Section_Storage], Source={StaticResource Loc}}" />
            <Border Padding="16" Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="20"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE7B8;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding [Settings_Cache_Title], Source={StaticResource Loc}}" />
                        <TextBlock Style="{StaticResource CardCaptionStyle}" Text="{x:Bind ViewModel.CacheSizeText, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <Button Click="OnRefreshCacheClick" Content="{Binding [Settings_Refresh], Source={StaticResource Loc}}" />
                        <Button Click="OnClearCacheClick" Content="{Binding [Settings_ClearCache], Source={StaticResource Loc}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  About  -->
            <TextBlock
                Margin="0,14,0,4"
                Style="{StaticResource SectionTitleStyle}"
                Text="{Binding [Settings_Section_About], Source={StaticResource Loc}}" />
            <Border Padding="20" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="48"
                            Height="48"
                            Background="{ThemeResource AccentFillColorTertiaryBrush}"
                            CornerRadius="10">
                            <Image Source="Assets/AppIcon.png" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding [Settings_About_Name], Source={StaticResource Loc}}" />
                            <TextBlock Style="{StaticResource CardCaptionStyle}" Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource CardCaptionStyle}" Text="{Binding [Settings_About_Description], Source={StaticResource Loc}}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Spacing="6">
                            <HyperlinkButton
                                HorizontalAlignment="Left"
                                Content="{Binding [Settings_About_GitHub], Source={StaticResource Loc}}"
                                NavigateUri="{x:Bind ViewModel.GitHubUrl}" />
                            <TextBlock
                                Margin="12,0,0,0"
                                Style="{StaticResource CardCaptionStyle}"
                                Text="{Binding [Settings_About_License], Source={StaticResource Loc}}" />
                            <Button
                                Margin="0,6,0,0"
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="{Binding [Settings_Exit], Source={StaticResource Loc}}"
                                Click="OnExitClick"
                                Content="{Binding [Settings_Exit], Source={StaticResource Loc}}" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="20"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE72C;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding [Settings_Update_Title], Source={StaticResource Loc}}" />
                            <TextBlock Style="{StaticResource CardCaptionStyle}" Text="{x:Bind ViewModel.UpdateStatusText, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                            <HyperlinkButton
                                Content="{Binding [Settings_Update_Open], Source={StaticResource Loc}}"
                                NavigateUri="{x:Bind ViewModel.UpdateReleaseUrl, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.UpdateAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            <Button
                                AutomationProperties.Name="{Binding [Settings_Update_Check], Source={StaticResource Loc}}"
                                Click="OnCheckForUpdatesClick"
                                Content="{Binding [Settings_Update_Check], Source={StaticResource Loc}}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
