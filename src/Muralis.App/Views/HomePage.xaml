<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Muralis.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Muralis.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Muralis.Core.Models"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="WallpaperRowTemplate" x:DataType="models:Wallpaper">
            <controls:WallpaperCard
                Width="232"
                Height="131"
                Wallpaper="{x:Bind}" />
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <ScrollViewer Padding="36,24,36,40" VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="1180"
                HorizontalAlignment="Left"
                Spacing="26">

                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="{x:Bind ViewModel.Greeting}" />
                    <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="{Binding [Home_Subtitle], Source={StaticResource Loc}}" />
                </StackPanel>

                <InfoBar
                    IsClosable="False"
                    IsOpen="True"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Severity="Error"
                    Title="{Binding [Common_Error_Title], Source={StaticResource Loc}}"
                    Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVisibility}}" />

                <!--  Featured wallpaper  -->
                <Border
                    Height="330"
                    Style="{StaticResource LargeCardBorderStyle}"
                    Visibility="{x:Bind ViewModel.Featured, Mode=OneWay, Converter={StaticResource NullToVisibility}}">
                    <Grid>
                        <Image
                            Source="{x:Bind ViewModel.Featured.DisplayImagePath, Mode=OneWay, Converter={StaticResource PathToImageSource}}"
                            Stretch="UniformToFill" />
                        <Border
                            Height="230"
                            VerticalAlignment="Bottom"
                            CornerRadius="0,0,12,12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#00000000" />
                                    <GradientStop Offset="1" Color="#D9000000" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel
                            Margin="28,0,28,26"
                            VerticalAlignment="Bottom"
                            Spacing="10">
                            <Border
                                Padding="8,3"
                                HorizontalAlignment="Left"
                                Background="#4D000000"
                                CornerRadius="4">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="White"
                                    Text="{Binding [Home_FeaturedToday], Source={StaticResource Loc}}" />
                            </Border>
                            <TextBlock
                                Foreground="White"
                                Style="{StaticResource TitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.Featured.Title, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="#CCFFFFFF"
                                    Text="{x:Bind ViewModel.Featured.ResolutionText, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.Featured.ResolutionText, Mode=OneWay, Converter={StaticResource NullToVisibility}}" />
                                <Button
                                    Click="OnFeaturedDetailsClick"
                                    Content="{Binding [Home_ViewDetails], Source={StaticResource Loc}}"
                                    Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Recommended row  -->
                <StackPanel Spacing="6">
                    <Grid>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{Binding [Home_Recommended], Source={StaticResource Loc}}" />
                        <HyperlinkButton
                            HorizontalAlignment="Right"
                            Click="OnBrowseAllClick"
                            Content="{Binding [Home_BrowseAll], Source={StaticResource Loc}}" />
                    </Grid>
                    <ListView
                        Padding="0"
                        IsItemClickEnabled="True"
                        ItemClick="OnWallpaperItemClick"
                        ItemContainerStyle="{StaticResource WallpaperRowItemContainerStyle}"
                        ItemTemplate="{StaticResource WallpaperRowTemplate}"
                        ItemsSource="{x:Bind ViewModel.Recommended}"
                        SelectionMode="None"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollMode="Enabled"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollMode="Disabled">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                    </ListView>
                </StackPanel>

                <!--  Recently used  -->
                <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.HasRecent, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{Binding [Home_RecentlyUsed], Source={StaticResource Loc}}" />
                    <ListView
                        Padding="0"
                        IsItemClickEnabled="True"
                        ItemClick="OnWallpaperItemClick"
                        ItemContainerStyle="{StaticResource WallpaperRowItemContainerStyle}"
                        ItemTemplate="{StaticResource WallpaperRowTemplate}"
                        ItemsSource="{x:Bind ViewModel.RecentlyUsed}"
                        SelectionMode="None"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollMode="Enabled"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollMode="Disabled">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                    </ListView>
                </StackPanel>

                <!--  Quick tiles  -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Padding="18"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Click="OnFavoritesTileClick"
                        CornerRadius="8">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="40"
                                Height="40"
                                Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                CornerRadius="20">
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    Glyph="&#xE734;" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding [Home_QuickFavorites_Title], Source={StaticResource Loc}}" />
                                <TextBlock Style="{StaticResource CardCaptionStyle}" Text="{Binding [Home_QuickFavorites_Description], Source={StaticResource Loc}}" />
                            </StackPanel>
                            <FontIcon
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE76C;" />
                        </Grid>
                    </Button>

                    <Button
                        Grid.Column="1"
                        Padding="18"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Click="OnLibraryTileClick"
                        CornerRadius="8">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="40"
                                Height="40"
                                Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                CornerRadius="20">
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    Glyph="&#xE8B9;" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding [Home_QuickLibrary_Title], Source={StaticResource Loc}}" />
                                <TextBlock Style="{StaticResource CardCaptionStyle}" Text="{Binding [Home_QuickLibrary_Description], Source={StaticResource Loc}}" />
                            </StackPanel>
                            <FontIcon
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE76C;" />
                        </Grid>
                    </Button>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <ProgressRing
            Width="44"
            Height="44"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{x:Bind ViewModel.IsInitialLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsInitialLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</Page>
