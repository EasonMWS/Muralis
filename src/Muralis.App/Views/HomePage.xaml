<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Muralis.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Muralis.App.Controls"
    xmlns:materials="using:Muralis.App.UI.Materials"
    xmlns:ui="using:Muralis.App.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Muralis.Core.Models"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="WallpaperRowTemplate" x:DataType="models:Wallpaper">
            <controls:WallpaperCard
                Width="260"
                Height="146"
                Wallpaper="{x:Bind}" />
        </DataTemplate>
    </Page.Resources>

    <Grid Background="Transparent">
        <!--  The two drawings of the desktop and the accent that marks the running one. Nothing here reacts
              on its own: the page is what moves its card between the native desktop and the running mode,
              and the states carry the motion the design tokens describe. The group sits on the page's own
              root because that is the only place VisualStateManager can find it from the page.

              Every state is a storyboard of opacities and no state sets a colour. A theme resource named in
              a visual state is re-resolved against the system theme rather than the app's when the state is
              left, which painted every caption on the card in the light theme's grey on a dark card once:
              the accent is a second dot in the same place, cross-faded, rather than a colour set here.  -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="HeroDesktop">
                <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="{StaticResource MuralisMotionStandard}" />
                </VisualStateGroup.Transitions>
                <VisualState x:Name="WindowsDesktop">
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetName="HeroStatusDotIdle"
                            Storyboard.TargetProperty="Opacity"
                            To="1"
                            Duration="{StaticResource MuralisMotionStandard}" />
                        <DoubleAnimation
                            Storyboard.TargetName="HeroStatusDotActive"
                            Storyboard.TargetProperty="Opacity"
                            To="0"
                            Duration="{StaticResource MuralisMotionStandard}" />
                        <DoubleAnimation
                            Storyboard.TargetName="HeroNativeLayer"
                            Storyboard.TargetProperty="Opacity"
                            To="1"
                            Duration="{StaticResource MuralisMotionStandard}" />
                        <DoubleAnimation
                            Storyboard.TargetName="HeroMuralisLayer"
                            Storyboard.TargetProperty="Opacity"
                            To="0"
                            Duration="{StaticResource MuralisMotionStandard}" />
                        <DoubleAnimation
                            Storyboard.TargetName="HeroAccentEdge"
                            Storyboard.TargetProperty="Opacity"
                            To="0"
                            Duration="{StaticResource MuralisMotionStandard}" />
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="MuralisDesktop">
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetName="HeroStatusDotIdle"
                            Storyboard.TargetProperty="Opacity"
                            To="0"
                            Duration="{StaticResource MuralisMotionStandard}" />
                        <DoubleAnimation
                            Storyboard.TargetName="HeroStatusDotActive"
                            Storyboard.TargetProperty="Opacity"
                            To="1"
                            Duration="{StaticResource MuralisMotionStandard}" />
                        <DoubleAnimation
                            Storyboard.TargetName="HeroNativeLayer"
                            Storyboard.TargetProperty="Opacity"
                            To="0"
                            Duration="{StaticResource MuralisMotionStandard}" />
                        <DoubleAnimation
                            Storyboard.TargetName="HeroMuralisLayer"
                            Storyboard.TargetProperty="Opacity"
                            To="1"
                            Duration="{StaticResource MuralisMotionStandard}" />
                        <DoubleAnimation
                            Storyboard.TargetName="HeroMuralisScale"
                            Storyboard.TargetProperty="ScaleX"
                            To="1"
                            Duration="{StaticResource MuralisMotionSlow}" />
                        <DoubleAnimation
                            Storyboard.TargetName="HeroMuralisScale"
                            Storyboard.TargetProperty="ScaleY"
                            To="1"
                            Duration="{StaticResource MuralisMotionSlow}" />
                        <DoubleAnimation
                            Storyboard.TargetName="HeroAccentEdge"
                            Storyboard.TargetProperty="Opacity"
                            To="1"
                            Duration="{StaticResource MuralisMotionSlow}" />
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Border IsHitTestVisible="False" Opacity="0.24">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="{ThemeResource MuralisWallpaperMoodColor}" />
                    <GradientStop Offset="0.46" Color="{ThemeResource MuralisScrimTransparentColor}" />
                    <GradientStop Offset="1" Color="{ThemeResource MuralisSurfaceTintColor}" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <ScrollViewer Padding="{StaticResource MuralisPageInset}" VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="1180"
                HorizontalAlignment="Left"
                    Spacing="28">

                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="{x:Bind ViewModel.Greeting}" />
                    <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="{Binding [Home_Subtitle], Source={StaticResource Loc}}" />
                </StackPanel>

                <InfoBar
                    IsClosable="False"
                    IsOpen="True"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Severity="Error"
                    Title="{Binding [Common_Error_Title], Source={StaticResource Loc}}"
                    Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVisibility}}" />

                <!--  Muralis Mode hero: the flagship entry point, the settings page is where it is configured  -->
                <materials:GlassSurface Padding="32,28,28,28" Style="{StaticResource MuralisGlassHighStyle}">
                    <Grid x:Name="HeroSurface" ColumnSpacing="0" SizeChanged="OnHeroSurfaceSizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="14" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Grid Width="9" Height="9" VerticalAlignment="Center">
                                    <Ellipse
                                        x:Name="HeroStatusDotIdle"
                                        Fill="{ThemeResource MuralisTextTertiaryBrush}" />
                                    <Ellipse
                                        x:Name="HeroStatusDotActive"
                                        Opacity="0"
                                        Fill="{ThemeResource MuralisAccentPrimaryBrush}" />
                                </Grid>
                                <TextBlock
                                    AutomationProperties.AutomationId="HeroEyebrowText"
                                    VerticalAlignment="Center"
                                    CharacterSpacing="30"
                                    FontWeight="SemiBold"
                                    Style="{StaticResource MuralisCaptionTextStyle}"
                                    Foreground="{ThemeResource MuralisTextSecondaryBrush}"
                                    Text="{x:Bind ViewModel.HeroTitle, Mode=OneWay}" />
                                <ProgressRing
                                    Width="14"
                                    Height="14"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource MuralisAccentPrimaryBrush}"
                                    IsActive="{x:Bind ViewModel.IsHeroBusy, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.IsHeroBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>

                            <TextBlock
                                AutomationProperties.AutomationId="HeroStatusText"
                                Style="{StaticResource MuralisTitleLargeTextStyle}"
                                Text="{x:Bind ViewModel.HeroStatus, Mode=OneWay}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Foreground="{ThemeResource MuralisTextSecondaryBrush}"
                                Style="{StaticResource MuralisBodyTextStyle}"
                                Text="{x:Bind ViewModel.HeroTagline, Mode=OneWay}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Style="{StaticResource CardCaptionStyle}"
                                Foreground="{ThemeResource MuralisTextTertiaryBrush}"
                                Text="{x:Bind ViewModel.HeroErrorDetail, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.HeroErrorDetail, Mode=OneWay, Converter={StaticResource NullToVisibility}}" />

                            <Grid ColumnSpacing="10" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border
                                    Padding="10,6"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource MuralisSurfaceLowBrush}"
                                    BorderBrush="{ThemeResource MuralisBorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource MuralisRadiusXS}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Style="{StaticResource MuralisCaptionTextStyle}" Text="{x:Bind ViewModel.HeroDockLabel, Mode=OneWay}" />
                                        <TextBlock
                                            AutomationProperties.AutomationId="HeroDockStatus"
                                            Style="{StaticResource MuralisCaptionTextStyle}"
                                            Foreground="{ThemeResource MuralisAccentPrimaryBrush}"
                                            Text="{x:Bind ViewModel.HeroDockStatus, Mode=OneWay}"
                                            Visibility="{x:Bind ViewModel.HeroDockStatus, Mode=OneWay, Converter={StaticResource NullToVisibility}}" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Grid.Column="1"
                                    Padding="10,6"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource MuralisSurfaceLowBrush}"
                                    BorderBrush="{ThemeResource MuralisBorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource MuralisRadiusXS}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Style="{StaticResource MuralisCaptionTextStyle}" Text="{x:Bind ViewModel.HeroShelfLabel, Mode=OneWay}" />
                                        <TextBlock
                                            AutomationProperties.AutomationId="HeroShelfStatus"
                                            Style="{StaticResource MuralisCaptionTextStyle}"
                                            Foreground="{ThemeResource MuralisAccentPrimaryBrush}"
                                            Text="{x:Bind ViewModel.HeroShelfStatus, Mode=OneWay}"
                                            Visibility="{x:Bind ViewModel.HeroShelfStatus, Mode=OneWay, Converter={StaticResource NullToVisibility}}" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Grid.Row="1"
                                    Padding="10,6"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource MuralisSurfaceLowBrush}"
                                    BorderBrush="{ThemeResource MuralisBorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource MuralisRadiusXS}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Style="{StaticResource MuralisCaptionTextStyle}" Text="{x:Bind ViewModel.HeroMotionLabel, Mode=OneWay}" />
                                        <TextBlock
                                            Style="{StaticResource MuralisCaptionTextStyle}"
                                            Foreground="{ThemeResource MuralisTextTertiaryBrush}"
                                            Text="{x:Bind ViewModel.HeroMotionStatus, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Padding="10,6"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource MuralisSurfaceLowBrush}"
                                    BorderBrush="{ThemeResource MuralisBorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource MuralisRadiusXS}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Style="{StaticResource MuralisCaptionTextStyle}" Text="{x:Bind ViewModel.HeroWidgetsLabel, Mode=OneWay}" />
                                        <TextBlock
                                            Style="{StaticResource MuralisCaptionTextStyle}"
                                            Foreground="{ThemeResource MuralisTextTertiaryBrush}"
                                            Text="{x:Bind ViewModel.HeroWidgetsStatus, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <StackPanel
                                Margin="0,4,0,0"
                                Orientation="Horizontal"
                                Spacing="12">
                                <ui:MuralisButton
                                    AutomationProperties.AutomationId="HeroPrimaryAction"
                                    Command="{x:Bind ViewModel.EnterMuralisModeCommand}"
                                    Content="{x:Bind ViewModel.HeroPrimaryText, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.CanUseMuralisModeActions, Mode=OneWay}"
                                    Variant="Primary"
                                    Visibility="{x:Bind ViewModel.ShowsWindowsDesktop, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <ui:MuralisButton
                                    AutomationProperties.AutomationId="HeroCustomizeAction"
                                    Command="{x:Bind ViewModel.CustomizeMuralisModeCommand}"
                                    Content="{x:Bind ViewModel.HeroCustomizeText, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.CanUseMuralisModeActions, Mode=OneWay}"
                                    Variant="Primary"
                                    Visibility="{x:Bind ViewModel.IsHeroActive, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <ui:MuralisButton
                                    AutomationProperties.AutomationId="HeroExitAction"
                                    Command="{x:Bind ViewModel.ExitMuralisModeCommand}"
                                    Content="{x:Bind ViewModel.HeroExitText, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.CanUseMuralisModeActions, Mode=OneWay}"
                                    Variant="Ghost"
                                    Visibility="{x:Bind ViewModel.IsHeroActive, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </StackPanel>

                        <!--  Mini desktop preview: a drawing of the desktop, never a picture of it. Shown only
                              when the card is wide enough for it and the words beside it: the code behind
                              puts it away below that rather than letting it squeeze the words. Its surface
                              is pinned rather than left to the glass style: the style's own brush resolves
                              against the wrong theme, which paints the panel pale on a dark card.  -->
                        <materials:GlassSurface
                            x:Name="HeroPreview"
                            Grid.Column="1"
                            Width="360"
                            Height="240"
                            Margin="28,0,0,0"
                            VerticalAlignment="Center"
                            Background="{ThemeResource MuralisSurfaceLowBrush}"
                            AutomationProperties.AutomationId="HeroPreview"
                            AutomationProperties.Name="{Binding [Home_MuralisMode_Preview], Source={StaticResource Loc}}"
                            CornerRadius="{StaticResource MuralisRadiusS}"
                            IsHitTestVisible="False"
                            IsTabStop="False"
                            Level="Low"
                            Padding="0"
                            Visibility="Collapsed">
                            <Grid>
                                <Grid x:Name="HeroNativeLayer">
                                    <Border CornerRadius="{StaticResource MuralisRadiusS}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Offset="0" Color="{ThemeResource MuralisWallpaperMoodColor}" />
                                                <GradientStop Offset="0.56" Color="{ThemeResource MuralisScrimTransparentColor}" />
                                                <GradientStop Offset="1" Color="{ThemeResource MuralisSurfaceTintColor}" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Grid
                                        Margin="16,16,16,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        ColumnSpacing="9"
                                        RowSpacing="9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Width="16" Height="16" CornerRadius="4" Background="{ThemeResource MuralisSurfaceHighBrush}" Opacity="0.9" />
                                        <Border Grid.Column="1" Width="16" Height="16" CornerRadius="4" Background="{ThemeResource MuralisSurfaceHighBrush}" Opacity="0.9" />
                                        <Border Grid.Column="2" Width="16" Height="16" CornerRadius="4" Background="{ThemeResource MuralisSurfaceHighBrush}" Opacity="0.9" />
                                        <Border Grid.Row="1" Width="16" Height="16" CornerRadius="4" Background="{ThemeResource MuralisSurfaceHighBrush}" Opacity="0.9" />
                                        <Border Grid.Row="1" Grid.Column="1" Width="16" Height="16" CornerRadius="4" Background="{ThemeResource MuralisSurfaceHighBrush}" Opacity="0.9" />
                                        <Border Grid.Row="1" Grid.Column="2" Width="16" Height="16" CornerRadius="4" Background="{ThemeResource MuralisSurfaceHighBrush}" Opacity="0.9" />
                                    </Grid>
                                    <Border
                                        Height="26"
                                        Margin="8,0,8,10"
                                        VerticalAlignment="Bottom"
                                        Background="{ThemeResource MuralisSurfaceLowBrush}"
                                        BorderBrush="{ThemeResource MuralisBorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource MuralisRadiusXS}">
                                        <StackPanel
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                            <Border Width="14" Height="14" CornerRadius="3" Background="{ThemeResource MuralisSurfaceSelectedBrush}" />
                                            <Border Width="14" Height="14" CornerRadius="3" Background="{ThemeResource MuralisSurfaceSelectedBrush}" />
                                            <Border Width="14" Height="14" CornerRadius="3" Background="{ThemeResource MuralisSurfaceSelectedBrush}" />
                                            <Border Width="14" Height="14" CornerRadius="3" Background="{ThemeResource MuralisSurfaceSelectedBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid x:Name="HeroMuralisLayer" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <ScaleTransform x:Name="HeroMuralisScale" ScaleX="0.985" ScaleY="0.985" />
                                    </Grid.RenderTransform>
                                    <Border CornerRadius="{StaticResource MuralisRadiusS}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Offset="0" Color="{ThemeResource MuralisWallpaperMoodColor}" />
                                                <GradientStop Offset="0.56" Color="{ThemeResource MuralisScrimTransparentColor}" />
                                                <GradientStop Offset="1" Color="{ThemeResource MuralisSurfaceTintColor}" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border
                                        Width="96"
                                        Height="56"
                                        Margin="16,16,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Background="{ThemeResource MuralisGlassMediumBrush}"
                                        BorderBrush="{ThemeResource MuralisBorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource MuralisRadiusXS}">
                                        <StackPanel
                                            Margin="10,0"
                                            VerticalAlignment="Center"
                                            Spacing="6">
                                            <Border Height="4" HorizontalAlignment="Left" Background="{ThemeResource MuralisTextTertiaryBrush}" CornerRadius="2" Opacity="0.6" Width="42" />
                                            <Border Height="4" HorizontalAlignment="Left" Background="{ThemeResource MuralisTextTertiaryBrush}" CornerRadius="2" Opacity="0.4" Width="28" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel
                                        Margin="0,16,16,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Spacing="6">
                                        <Grid>
                                            <Border
                                                Width="58"
                                                Height="14"
                                                Background="{ThemeResource MuralisSurfaceHighBrush}"
                                                BorderBrush="{ThemeResource MuralisBorderSubtleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4" />
                                            <Border
                                                Width="2"
                                                Height="7"
                                                Margin="6,0,0,0"
                                                HorizontalAlignment="Left"
                                                Background="{ThemeResource MuralisAccentPrimaryBrush}"
                                                CornerRadius="1" />
                                        </Grid>
                                        <Grid>
                                            <Border
                                                Width="58"
                                                Height="14"
                                                Background="{ThemeResource MuralisSurfaceHighBrush}"
                                                BorderBrush="{ThemeResource MuralisBorderSubtleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4" />
                                            <Border
                                                Width="2"
                                                Height="7"
                                                Margin="6,0,0,0"
                                                HorizontalAlignment="Left"
                                                Background="{ThemeResource MuralisAccentPrimaryBrush}"
                                                CornerRadius="1" />
                                        </Grid>
                                        <Grid>
                                            <Border
                                                Width="58"
                                                Height="14"
                                                Background="{ThemeResource MuralisSurfaceHighBrush}"
                                                BorderBrush="{ThemeResource MuralisBorderSubtleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4" />
                                            <Border
                                                Width="2"
                                                Height="7"
                                                Margin="6,0,0,0"
                                                HorizontalAlignment="Left"
                                                Background="{ThemeResource MuralisAccentPrimaryBrush}"
                                                CornerRadius="1" />
                                        </Grid>
                                    </StackPanel>
                                    <Border
                                        Margin="0,0,0,12"
                                        Padding="8,7"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        Background="{ThemeResource MuralisGlassHighBrush}"
                                        BorderBrush="{ThemeResource MuralisBorderNormalBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource MuralisRadiusS}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border Width="24" Height="24" CornerRadius="6" Background="{ThemeResource MuralisSurfaceHighBrush}" BorderBrush="{ThemeResource MuralisBorderSubtleBrush}" BorderThickness="1" />
                                            <Border Width="24" Height="24" CornerRadius="6" Background="{ThemeResource MuralisSurfaceHighBrush}" BorderBrush="{ThemeResource MuralisBorderSubtleBrush}" BorderThickness="1" />
                                            <Border
                                                Width="24"
                                                Height="24"
                                                Background="{ThemeResource MuralisSurfaceSelectedBrush}"
                                                BorderBrush="{ThemeResource MuralisBorderActiveBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6" />
                                            <Border Width="24" Height="24" CornerRadius="6" Background="{ThemeResource MuralisSurfaceHighBrush}" BorderBrush="{ThemeResource MuralisBorderSubtleBrush}" BorderThickness="1" />
                                            <Border Width="24" Height="24" CornerRadius="6" Background="{ThemeResource MuralisSurfaceHighBrush}" BorderBrush="{ThemeResource MuralisBorderSubtleBrush}" BorderThickness="1" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </materials:GlassSurface>

                        <Border
                            x:Name="HeroAccentEdge"
                            Width="96"
                            Height="2"
                            Margin="32,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="{ThemeResource MuralisAccentPrimaryBrush}"
                            CornerRadius="{StaticResource MuralisRadiusPill}"
                            IsHitTestVisible="False"
                            Opacity="0" />
                    </Grid>
                </materials:GlassSurface>

                <!--  Featured wallpaper  -->
                <Border
                    Height="356"
                    Style="{StaticResource LargeCardBorderStyle}"
                    Visibility="{x:Bind ViewModel.Featured, Mode=OneWay, Converter={StaticResource NullToVisibility}}">
                    <Grid>
                        <Image
                            Source="{x:Bind ViewModel.Featured.DisplayImagePath, Mode=OneWay, Converter={StaticResource PathToImageSource}, ConverterParameter=1024}"
                            Stretch="UniformToFill" />
                        <Border IsHitTestVisible="False" CornerRadius="{StaticResource MuralisRadiusM}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="{ThemeResource MuralisScrimSideColor}" />
                                    <GradientStop Offset="0.58" Color="{ThemeResource MuralisScrimTransparentColor}" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border
                            Height="230"
                            VerticalAlignment="Bottom"
                            CornerRadius="0,0,16,16">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="{ThemeResource MuralisScrimTransparentColor}" />
                                    <GradientStop Offset="1" Color="{ThemeResource MuralisScrimStrongColor}" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel
                            Margin="28,0,28,28"
                            VerticalAlignment="Bottom"
                            Spacing="10">
                            <Border
                                Padding="9,4"
                                HorizontalAlignment="Left"
                                Background="{ThemeResource MuralisSurfaceHighBrush}"
                                BorderBrush="{ThemeResource MuralisBorderNormalBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource MuralisRadiusXS}">
                                <TextBlock
                                    Style="{StaticResource MuralisCaptionTextStyle}"
                                    Foreground="{ThemeResource MuralisTextPrimaryBrush}"
                                    Text="{Binding [Home_FeaturedToday], Source={StaticResource Loc}}" />
                            </Border>
                            <TextBlock
                                Foreground="{ThemeResource MuralisOnImagePrimaryBrush}"
                                Style="{StaticResource MuralisTitleTextStyle}"
                                Text="{x:Bind ViewModel.Featured.Title, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource MuralisBodySmallTextStyle}"
                                    Foreground="{ThemeResource MuralisOnImageSecondaryBrush}"
                                    Text="{x:Bind ViewModel.Featured.ResolutionText, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.Featured.ResolutionText, Mode=OneWay, Converter={StaticResource NullToVisibility}}" />
                                <ui:MuralisButton
                                    Click="OnFeaturedDetailsClick"
                                    Content="{Binding [Home_ViewDetails], Source={StaticResource Loc}}"
                                    Variant="Primary" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Recommended row  -->
                <StackPanel Spacing="6">
                    <Grid Margin="0,0,0,4">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{Binding [Home_Recommended], Source={StaticResource Loc}}" />
                        <HyperlinkButton
                            HorizontalAlignment="Right"
                            Click="OnBrowseAllClick"
                            Content="{Binding [Home_BrowseAll], Source={StaticResource Loc}}"
                            Style="{StaticResource SectionActionStyle}" />
                    </Grid>
                    <Grid>
                        <ListView
                            Padding="0,0,48,0"
                            IsItemClickEnabled="True"
                            ItemClick="OnWallpaperItemClick"
                            ItemContainerStyle="{StaticResource WallpaperRowItemContainerStyle}"
                            ItemTemplate="{StaticResource WallpaperRowTemplate}"
                            ItemsSource="{x:Bind ViewModel.Recommended}"
                            SelectionMode="None"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            ScrollViewer.HorizontalScrollMode="Enabled"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollMode="Disabled">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                        </ListView>
                        <Border Width="34" HorizontalAlignment="Right" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="{ThemeResource MuralisScrimTransparentColor}" />
                                    <GradientStop Offset="1" Color="{ThemeResource MuralisBackground0Color}" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                </StackPanel>

                <!--  Recently used  -->
                <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.HasRecent, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Margin="0,0,0,4" Style="{StaticResource SectionTitleStyle}" Text="{Binding [Home_RecentlyUsed], Source={StaticResource Loc}}" />
                    <ListView
                        Padding="0,0,48,0"
                        IsItemClickEnabled="True"
                        ItemClick="OnWallpaperItemClick"
                        ItemContainerStyle="{StaticResource WallpaperRowItemContainerStyle}"
                        ItemTemplate="{StaticResource WallpaperRowTemplate}"
                        ItemsSource="{x:Bind ViewModel.RecentlyUsed}"
                        SelectionMode="None"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollMode="Enabled"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollMode="Disabled">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                    </ListView>
                </StackPanel>

                <!--  Quick tiles  -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ui:MuralisButton
                        Padding="{StaticResource MuralisInsetM}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Click="OnFavoritesTileClick"
                        Variant="Secondary">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="40"
                                Height="40"
                                Background="{ThemeResource MuralisSurfaceSelectedBrush}"
                                CornerRadius="{StaticResource MuralisRadiusPill}">
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{ThemeResource MuralisAccentPrimaryBrush}"
                                    Glyph="&#xE734;" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding [Home_QuickFavorites_Title], Source={StaticResource Loc}}" />
                                <TextBlock Style="{StaticResource CardCaptionStyle}" Text="{Binding [Home_QuickFavorites_Description], Source={StaticResource Loc}}" />
                            </StackPanel>
                            <FontIcon
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource MuralisTextSecondaryBrush}"
                                Glyph="&#xE76C;" />
                        </Grid>
                    </ui:MuralisButton>

                    <ui:MuralisButton
                        Grid.Column="1"
                        Padding="{StaticResource MuralisInsetM}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Click="OnLibraryTileClick"
                        Variant="Secondary">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="40"
                                Height="40"
                                Background="{ThemeResource MuralisSurfaceSelectedBrush}"
                                CornerRadius="{StaticResource MuralisRadiusPill}">
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{ThemeResource MuralisAccentPrimaryBrush}"
                                    Glyph="&#xE8B9;" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding [Home_QuickLibrary_Title], Source={StaticResource Loc}}" />
                                <TextBlock Style="{StaticResource CardCaptionStyle}" Text="{Binding [Home_QuickLibrary_Description], Source={StaticResource Loc}}" />
                            </StackPanel>
                            <FontIcon
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource MuralisTextSecondaryBrush}"
                                Glyph="&#xE76C;" />
                        </Grid>
                    </ui:MuralisButton>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <ProgressRing
            Width="44"
            Height="44"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{x:Bind ViewModel.IsInitialLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsInitialLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</Page>
