<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Muralis.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Muralis.App.Controls"
    xmlns:materials="using:Muralis.App.UI.Materials"
    xmlns:ui="using:Muralis.App.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Muralis.Core.Models"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="WallpaperRowTemplate" x:DataType="models:Wallpaper">
            <controls:WallpaperCard
                Width="260"
                Height="146"
                Wallpaper="{x:Bind}" />
        </DataTemplate>
    </Page.Resources>

    <Grid Background="Transparent">
        <!--  The two drawings of the desktop and the accent that marks the running one. Nothing here reacts
              on its own: the page is what moves its card between the native desktop and the running mode,
              and the states carry the motion the design tokens describe. The group sits on the page's own
              root because that is the only place VisualStateManager can find it from the page.

              Every state is a storyboard of opacities and no state sets a colour. A theme resource named in
              a visual state is re-resolved against the system theme rather than the app's when the state is
              left, which painted every caption on the card in the light theme's grey on a dark card once:
              the accent is a second dot in the same place, cross-faded, rather than a colour set here.  -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="HeroDesktop">
                <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="{StaticResource MuralisMotionStandard}" />
                </VisualStateGroup.Transitions>
                <VisualState x:Name="WindowsDesktop">
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetName="HeroStatusDotIdle"
                            Storyboard.TargetProperty="Opacity"
                            To="1"
                            Duration="{StaticResource MuralisMotionStandard}" />
                        <DoubleAnimation
                            Storyboard.TargetName="HeroStatusDotActive"
                            Storyboard.TargetProperty="Opacity"
                            To="0"
                            Duration="{StaticResource MuralisMotionStandard}" />
                        <DoubleAnimation
                            Storyboard.TargetName="HeroNativeLayer"
                            Storyboard.TargetProperty="Opacity"
                            To="1"
                            Duration="{StaticResource MuralisMotionStandard}" />
                        <DoubleAnimation
                            Storyboard.TargetName="HeroMuralisLayer"
                            Storyboard.TargetProperty="Opacity"
                            To="0.68"
                            Duration="{StaticResource MuralisMotionStandard}" />
                        <DoubleAnimation
                            Storyboard.TargetName="HeroMuralisScale"
                            Storyboard.TargetProperty="ScaleX"
                            To="0.985"
                            Duration="{StaticResource MuralisMotionStandard}" />
                        <DoubleAnimation
                            Storyboard.TargetName="HeroMuralisScale"
                            Storyboard.TargetProperty="ScaleY"
                            To="0.985"
                            Duration="{StaticResource MuralisMotionStandard}" />
                        <DoubleAnimation
                            Storyboard.TargetName="HeroAccentEdge"
                            Storyboard.TargetProperty="Opacity"
                            To="0"
                            Duration="{StaticResource MuralisMotionStandard}" />
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="MuralisDesktop">
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetName="HeroStatusDotIdle"
                            Storyboard.TargetProperty="Opacity"
                            To="0"
                            Duration="{StaticResource MuralisMotionStandard}" />
                        <DoubleAnimation
                            Storyboard.TargetName="HeroStatusDotActive"
                            Storyboard.TargetProperty="Opacity"
                            To="1"
                            Duration="{StaticResource MuralisMotionStandard}" />
                        <DoubleAnimation
                            Storyboard.TargetName="HeroNativeLayer"
                            Storyboard.TargetProperty="Opacity"
                            To="0.48"
                            Duration="{StaticResource MuralisMotionStandard}" />
                        <DoubleAnimation
                            Storyboard.TargetName="HeroMuralisLayer"
                            Storyboard.TargetProperty="Opacity"
                            To="1"
                            Duration="{StaticResource MuralisMotionStandard}" />
                        <DoubleAnimation
                            Storyboard.TargetName="HeroMuralisScale"
                            Storyboard.TargetProperty="ScaleX"
                            To="1"
                            Duration="{StaticResource MuralisMotionSlow}" />
                        <DoubleAnimation
                            Storyboard.TargetName="HeroMuralisScale"
                            Storyboard.TargetProperty="ScaleY"
                            To="1"
                            Duration="{StaticResource MuralisMotionSlow}" />
                        <DoubleAnimation
                            Storyboard.TargetName="HeroAccentEdge"
                            Storyboard.TargetProperty="Opacity"
                            To="1"
                            Duration="{StaticResource MuralisMotionSlow}" />
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Border IsHitTestVisible="False" Opacity="0.24">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="{ThemeResource MuralisWallpaperMoodColor}" />
                    <GradientStop Offset="0.46" Color="{ThemeResource MuralisScrimTransparentColor}" />
                    <GradientStop Offset="1" Color="{ThemeResource MuralisSurfaceTintColor}" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <ScrollViewer Padding="{StaticResource MuralisPageInset}" VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="1180"
                HorizontalAlignment="Left"
                    Spacing="28">

                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="{x:Bind ViewModel.Greeting}" />
                    <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="{Binding [Home_Subtitle], Source={StaticResource Loc}}" />
                </StackPanel>

                <InfoBar
                    IsClosable="False"
                    IsOpen="True"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Severity="Error"
                    Title="{Binding [Common_Error_Title], Source={StaticResource Loc}}"
                    Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVisibility}}" />

                <!--  Product hero: a composed desktop experience, not a settings card.  -->
                <materials:GlassSurface
                    x:Name="HeroCard"
                    MinHeight="360"
                    Padding="0"
                    Style="{StaticResource MuralisGlassHighStyle}">
                    <Grid
                        x:Name="HeroSurface"
                        MinHeight="360"
                        SizeChanged="OnHeroSurfaceSizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.RowSpan="2"
                            Grid.ColumnSpan="2"
                            CornerRadius="{StaticResource MuralisRadiusM}"
                            IsHitTestVisible="False"
                            Opacity="0.72">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0" Color="{ThemeResource MuralisSurfaceHighColor}" />
                                    <GradientStop Offset="0.5" Color="{ThemeResource MuralisSurfaceTintColor}" />
                                    <GradientStop Offset="1" Color="{ThemeResource MuralisWallpaperMoodColor}" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border
                            Grid.RowSpan="2"
                            Grid.ColumnSpan="2"
                            Width="560"
                            HorizontalAlignment="Right"
                            CornerRadius="{StaticResource MuralisRadiusM}"
                            IsHitTestVisible="False"
                            Opacity="0.34">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="{ThemeResource MuralisScrimTransparentColor}" />
                                    <GradientStop Offset="1" Color="{ThemeResource MuralisGlowTintColor}" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <StackPanel
                            x:Name="HeroCopy"
                            Margin="40,34,24,34"
                            MaxWidth="590"
                            VerticalAlignment="Center"
                            Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <Grid Width="9" Height="9" VerticalAlignment="Center">
                                    <Ellipse x:Name="HeroStatusDotIdle" Fill="{ThemeResource MuralisTextTertiaryBrush}" />
                                    <Ellipse
                                        x:Name="HeroStatusDotActive"
                                        Fill="{ThemeResource MuralisAccentPrimaryBrush}"
                                        Opacity="0" />
                                </Grid>
                                <TextBlock
                                    AutomationProperties.AutomationId="HeroStatusText"
                                    VerticalAlignment="Center"
                                    CharacterSpacing="20"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource MuralisTextSecondaryBrush}"
                                    Style="{StaticResource MuralisCaptionTextStyle}"
                                    Text="{x:Bind ViewModel.HeroStatus, Mode=OneWay}" />
                                <ProgressRing
                                    Width="14"
                                    Height="14"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource MuralisAccentPrimaryBrush}"
                                    IsActive="{x:Bind ViewModel.IsHeroBusy, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.IsHeroBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>

                            <TextBlock
                                AutomationProperties.AutomationId="HeroEyebrowText"
                                FontSize="38"
                                Style="{StaticResource MuralisDisplayTextStyle}"
                                Text="{x:Bind ViewModel.HeroTitle, Mode=OneWay}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                FontSize="17"
                                Foreground="{ThemeResource MuralisTextPrimaryBrush}"
                                Style="{StaticResource MuralisBodyTextStyle}"
                                Text="{Binding [Home_MuralisMode_Brand], Source={StaticResource Loc}}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                MaxWidth="530"
                                Foreground="{ThemeResource MuralisTextSecondaryBrush}"
                                Style="{StaticResource MuralisBodyTextStyle}"
                                Text="{x:Bind ViewModel.HeroTagline, Mode=OneWay}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Foreground="{ThemeResource MuralisTextTertiaryBrush}"
                                Style="{StaticResource CardCaptionStyle}"
                                Text="{x:Bind ViewModel.HeroErrorDetail, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.HeroErrorDetail, Mode=OneWay, Converter={StaticResource NullToVisibility}}" />

                            <Grid
                                x:Name="HeroFeatureSummary"
                                Margin="0,4,0,0"
                                ColumnSpacing="24"
                                RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel x:Name="HeroDockFeature" Orientation="Horizontal" Spacing="8">
                                    <Border Width="3" Height="16" Background="{ThemeResource MuralisAccentPrimaryBrush}" CornerRadius="2" />
                                    <TextBlock FontWeight="SemiBold" Style="{StaticResource MuralisBodySmallTextStyle}" Text="{x:Bind ViewModel.HeroDockLabel, Mode=OneWay}" />
                                    <TextBlock
                                        AutomationProperties.AutomationId="HeroDockStatus"
                                        Foreground="{ThemeResource MuralisAccentPrimaryBrush}"
                                        Style="{StaticResource MuralisCaptionTextStyle}"
                                        Text="{x:Bind ViewModel.HeroDockStatus, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.HeroDockStatus, Mode=OneWay, Converter={StaticResource NullToVisibility}}" />
                                </StackPanel>
                                <StackPanel x:Name="HeroShelfFeature" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Border Width="3" Height="16" Background="{ThemeResource MuralisAccentSecondaryBrush}" CornerRadius="2" />
                                    <TextBlock FontWeight="SemiBold" Style="{StaticResource MuralisBodySmallTextStyle}" Text="{x:Bind ViewModel.HeroShelfLabel, Mode=OneWay}" />
                                    <TextBlock
                                        AutomationProperties.AutomationId="HeroShelfStatus"
                                        Foreground="{ThemeResource MuralisAccentPrimaryBrush}"
                                        Style="{StaticResource MuralisCaptionTextStyle}"
                                        Text="{x:Bind ViewModel.HeroShelfStatus, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.HeroShelfStatus, Mode=OneWay, Converter={StaticResource NullToVisibility}}" />
                                </StackPanel>
                                <StackPanel x:Name="HeroMotionFeature" Grid.Row="1" Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="5" Height="5" VerticalAlignment="Center" Fill="{ThemeResource MuralisTextTertiaryBrush}" />
                                    <TextBlock Style="{StaticResource MuralisBodySmallTextStyle}" Text="{x:Bind ViewModel.HeroMotionLabel, Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource MuralisCaptionTextStyle}" Text="{x:Bind ViewModel.HeroMotionStatus, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel x:Name="HeroWidgetsFeature" Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="5" Height="5" VerticalAlignment="Center" Fill="{ThemeResource MuralisTextTertiaryBrush}" />
                                    <TextBlock Style="{StaticResource MuralisBodySmallTextStyle}" Text="{x:Bind ViewModel.HeroWidgetsLabel, Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource MuralisCaptionTextStyle}" Text="{x:Bind ViewModel.HeroWidgetsStatus, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,6,0,0" Orientation="Horizontal" Spacing="12">
                                <ui:MuralisButton
                                    AutomationProperties.AutomationId="HeroPrimaryAction"
                                    Command="{x:Bind ViewModel.EnterMuralisModeCommand}"
                                    Content="{x:Bind ViewModel.HeroPrimaryText, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.CanUseMuralisModeActions, Mode=OneWay}"
                                    Variant="Primary"
                                    Visibility="{x:Bind ViewModel.ShowsWindowsDesktop, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <ui:MuralisButton
                                    AutomationProperties.AutomationId="HeroCustomizeAction"
                                    Command="{x:Bind ViewModel.CustomizeMuralisModeCommand}"
                                    Content="{x:Bind ViewModel.HeroCustomizeText, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.CanUseMuralisModeActions, Mode=OneWay}"
                                    Variant="Primary"
                                    Visibility="{x:Bind ViewModel.IsHeroActive, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <ui:MuralisButton
                                    AutomationProperties.AutomationId="HeroExitAction"
                                    Command="{x:Bind ViewModel.ExitMuralisModeCommand}"
                                    Content="{x:Bind ViewModel.HeroExitText, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.CanUseMuralisModeActions, Mode=OneWay}"
                                    Variant="Ghost"
                                    Visibility="{x:Bind ViewModel.IsHeroActive, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </StackPanel>

                        <!--  Native and Muralis stay visible together so the product difference reads without copy.
                              The current mode only changes emphasis; the Muralis dock is intentionally panel-free.  -->
                        <materials:GlassSurface
                            x:Name="HeroPreview"
                            Grid.Column="1"
                            Width="420"
                            MaxWidth="520"
                            Height="270"
                            Margin="12,30,30,30"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="HeroPreview"
                            AutomationProperties.Name="{Binding [Home_MuralisMode_Preview], Source={StaticResource Loc}}"
                            Background="{ThemeResource MuralisSurfaceLowBrush}"
                            CornerRadius="{StaticResource MuralisRadiusM}"
                            IsHitTestVisible="False"
                            IsTabStop="False"
                            Level="Low"
                            Padding="0">
                            <Viewbox Stretch="Uniform">
                                <Grid Width="420" Height="270">
                                    <Border CornerRadius="{StaticResource MuralisRadiusM}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Offset="0" Color="{ThemeResource MuralisSurfaceHighColor}" />
                                                <GradientStop Offset="0.5" Color="{ThemeResource MuralisWallpaperMoodColor}" />
                                                <GradientStop Offset="1" Color="{ThemeResource MuralisSurfaceTintColor}" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <TextBlock
                                        Margin="22,16,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        CharacterSpacing="50"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource MuralisTextTertiaryBrush}"
                                        Style="{StaticResource MuralisCaptionTextStyle}"
                                        Text="{Binding [Home_MuralisMode_Preview_Native], Source={StaticResource Loc}}" />
                                    <TextBlock
                                        Margin="0,16,22,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        CharacterSpacing="50"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource MuralisAccentPrimaryBrush}"
                                        Style="{StaticResource MuralisCaptionTextStyle}"
                                        Text="{Binding [Home_MuralisMode_Preview_Muralis], Source={StaticResource Loc}}" />

                                    <Grid
                                        x:Name="HeroNativeLayer"
                                        Width="168"
                                        Height="174"
                                        Margin="20,45,0,22"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom">
                                        <Border
                                            Background="{ThemeResource MuralisSurfaceMediumBrush}"
                                            BorderBrush="{ThemeResource MuralisBorderNormalBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource MuralisRadiusS}" />
                                        <Border
                                            Height="22"
                                            VerticalAlignment="Top"
                                            Background="{ThemeResource MuralisSurfaceHighBrush}"
                                            CornerRadius="10,10,0,0">
                                            <StackPanel Margin="9,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
                                                <Ellipse Width="4" Height="4" Fill="{ThemeResource MuralisTextTertiaryBrush}" />
                                                <Ellipse Width="4" Height="4" Fill="{ThemeResource MuralisTextTertiaryBrush}" />
                                                <Ellipse Width="4" Height="4" Fill="{ThemeResource MuralisTextTertiaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Margin="12,34,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Spacing="9">
                                            <StackPanel Orientation="Horizontal" Spacing="7"><Border Width="17" Height="17" Background="{ThemeResource MuralisSurfaceSelectedBrush}" CornerRadius="3" /><Border Width="42" Height="5" VerticalAlignment="Center" Background="{ThemeResource MuralisTextTertiaryBrush}" CornerRadius="3" Opacity="0.55" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="7"><Border Width="17" Height="17" Background="{ThemeResource MuralisSurfaceSelectedBrush}" CornerRadius="3" /><Border Width="34" Height="5" VerticalAlignment="Center" Background="{ThemeResource MuralisTextTertiaryBrush}" CornerRadius="3" Opacity="0.45" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="7"><Border Width="17" Height="17" Background="{ThemeResource MuralisSurfaceSelectedBrush}" CornerRadius="3" /><Border Width="48" Height="5" VerticalAlignment="Center" Background="{ThemeResource MuralisTextTertiaryBrush}" CornerRadius="3" Opacity="0.5" /></StackPanel>
                                        </StackPanel>
                                        <Border
                                            Height="24"
                                            VerticalAlignment="Bottom"
                                            Background="{ThemeResource MuralisSurfaceHighBrush}"
                                            CornerRadius="0,0,10,10">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="5">
                                                <Border Width="11" Height="11" Background="{ThemeResource MuralisTextTertiaryBrush}" CornerRadius="2" Opacity="0.55" />
                                                <Border Width="11" Height="11" Background="{ThemeResource MuralisTextTertiaryBrush}" CornerRadius="2" Opacity="0.55" />
                                                <Border Width="11" Height="11" Background="{ThemeResource MuralisTextTertiaryBrush}" CornerRadius="2" Opacity="0.55" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Grid
                                        x:Name="HeroMuralisLayer"
                                        Width="238"
                                        Height="190"
                                        Margin="0,54,18,18"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Opacity="0.68"
                                        RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                            <ScaleTransform x:Name="HeroMuralisScale" ScaleX="0.985" ScaleY="0.985" />
                                        </Grid.RenderTransform>
                                        <Border
                                            BorderBrush="{ThemeResource MuralisBorderHoverBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource MuralisRadiusS}">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Offset="0" Color="{ThemeResource MuralisWallpaperMoodColor}" />
                                                    <GradientStop Offset="0.58" Color="{ThemeResource MuralisScrimTransparentColor}" />
                                                    <GradientStop Offset="1" Color="{ThemeResource MuralisGlowTintColor}" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border
                                            Width="78"
                                            Height="50"
                                            Margin="14,14,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Background="{ThemeResource MuralisGlassMediumBrush}"
                                            BorderBrush="{ThemeResource MuralisBorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource MuralisRadiusXS}">
                                            <StackPanel Margin="10,0" VerticalAlignment="Center" Spacing="6">
                                                <Border Width="38" Height="4" HorizontalAlignment="Left" Background="{ThemeResource MuralisTextSecondaryBrush}" CornerRadius="2" Opacity="0.68" />
                                                <Border Width="24" Height="4" HorizontalAlignment="Left" Background="{ThemeResource MuralisTextTertiaryBrush}" CornerRadius="2" Opacity="0.52" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Margin="0,14,14,0" HorizontalAlignment="Right" VerticalAlignment="Top" Spacing="6">
                                            <Grid><Border Width="52" Height="14" Background="{ThemeResource MuralisSurfaceHighBrush}" CornerRadius="4" /><Border Width="3" Height="8" Margin="6,0,0,0" HorizontalAlignment="Left" Background="{ThemeResource MuralisAccentPrimaryBrush}" CornerRadius="2" /></Grid>
                                            <Grid><Border Width="52" Height="14" Background="{ThemeResource MuralisSurfaceHighBrush}" CornerRadius="4" /><Border Width="3" Height="8" Margin="6,0,0,0" HorizontalAlignment="Left" Background="{ThemeResource MuralisAccentSecondaryBrush}" CornerRadius="2" /></Grid>
                                            <Grid><Border Width="52" Height="14" Background="{ThemeResource MuralisSurfaceHighBrush}" CornerRadius="4" /><Border Width="3" Height="8" Margin="6,0,0,0" HorizontalAlignment="Left" Background="{ThemeResource MuralisAccentPrimaryBrush}" CornerRadius="2" /></Grid>
                                        </StackPanel>

                                        <!--  Transparent Dock: icons float directly on the wallpaper, with no rail.  -->
                                        <StackPanel
                                            Margin="0,0,0,13"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            Orientation="Horizontal"
                                            Spacing="7">
                                            <Border Width="26" Height="26" Background="{ThemeResource MuralisSurfaceHighBrush}" BorderBrush="{ThemeResource MuralisBorderSubtleBrush}" BorderThickness="1" CornerRadius="7" />
                                            <Border Width="26" Height="26" Background="{ThemeResource MuralisSurfaceHighBrush}" BorderBrush="{ThemeResource MuralisBorderSubtleBrush}" BorderThickness="1" CornerRadius="7" />
                                            <Border Width="26" Height="26" Background="{ThemeResource MuralisSurfaceSelectedBrush}" BorderBrush="{ThemeResource MuralisBorderActiveBrush}" BorderThickness="1" CornerRadius="7" />
                                            <Border Width="26" Height="26" Background="{ThemeResource MuralisSurfaceHighBrush}" BorderBrush="{ThemeResource MuralisBorderSubtleBrush}" BorderThickness="1" CornerRadius="7" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Viewbox>
                        </materials:GlassSurface>

                        <Border
                            x:Name="HeroAccentEdge"
                            Grid.RowSpan="2"
                            Grid.ColumnSpan="2"
                            Width="116"
                            Height="2"
                            Margin="40,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="{ThemeResource MuralisAccentPrimaryBrush}"
                            CornerRadius="{StaticResource MuralisRadiusPill}"
                            IsHitTestVisible="False"
                            Opacity="0" />
                    </Grid>
                </materials:GlassSurface>

                <!--  Featured wallpaper  -->
                <Border
                    Height="332"
                    Style="{StaticResource LargeCardBorderStyle}"
                    Visibility="{x:Bind ViewModel.Featured, Mode=OneWay, Converter={StaticResource NullToVisibility}}">
                    <Grid>
                        <Image
                            Source="{x:Bind ViewModel.Featured.DisplayImagePath, Mode=OneWay, Converter={StaticResource PathToImageSource}, ConverterParameter=1024}"
                            Stretch="UniformToFill" />
                        <Border IsHitTestVisible="False" CornerRadius="{StaticResource MuralisRadiusM}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="{ThemeResource MuralisScrimSideColor}" />
                                    <GradientStop Offset="0.58" Color="{ThemeResource MuralisScrimTransparentColor}" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border
                            Height="230"
                            VerticalAlignment="Bottom"
                            CornerRadius="0,0,16,16">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="{ThemeResource MuralisScrimTransparentColor}" />
                                    <GradientStop Offset="1" Color="{ThemeResource MuralisScrimStrongColor}" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel
                            Margin="28,0,28,28"
                            VerticalAlignment="Bottom"
                            Spacing="10">
                            <Border
                                Padding="9,4"
                                HorizontalAlignment="Left"
                                Background="{ThemeResource MuralisSurfaceHighBrush}"
                                BorderBrush="{ThemeResource MuralisBorderNormalBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource MuralisRadiusXS}">
                                <TextBlock
                                    Style="{StaticResource MuralisCaptionTextStyle}"
                                    Foreground="{ThemeResource MuralisTextPrimaryBrush}"
                                    Text="{Binding [Home_FeaturedToday], Source={StaticResource Loc}}" />
                            </Border>
                            <TextBlock
                                Foreground="{ThemeResource MuralisOnImagePrimaryBrush}"
                                Style="{StaticResource MuralisTitleTextStyle}"
                                Text="{x:Bind ViewModel.Featured.Title, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource MuralisBodySmallTextStyle}"
                                    Foreground="{ThemeResource MuralisOnImageSecondaryBrush}"
                                    Text="{x:Bind ViewModel.Featured.ResolutionText, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.Featured.ResolutionText, Mode=OneWay, Converter={StaticResource NullToVisibility}}" />
                                <ui:MuralisButton
                                    Click="OnFeaturedDetailsClick"
                                    Content="{Binding [Home_ViewDetails], Source={StaticResource Loc}}"
                                    Variant="Primary" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Recommended row  -->
                <StackPanel Spacing="6">
                    <Grid Margin="0,0,0,4">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{Binding [Home_Recommended], Source={StaticResource Loc}}" />
                        <HyperlinkButton
                            HorizontalAlignment="Right"
                            Click="OnBrowseAllClick"
                            Content="{Binding [Home_BrowseAll], Source={StaticResource Loc}}"
                            Style="{StaticResource SectionActionStyle}" />
                    </Grid>
                    <Grid>
                        <ListView
                            Padding="0,0,48,0"
                            IsItemClickEnabled="True"
                            ItemClick="OnWallpaperItemClick"
                            ItemContainerStyle="{StaticResource WallpaperRowItemContainerStyle}"
                            ItemTemplate="{StaticResource WallpaperRowTemplate}"
                            ItemsSource="{x:Bind ViewModel.Recommended}"
                            SelectionMode="None"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            ScrollViewer.HorizontalScrollMode="Enabled"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollMode="Disabled">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                        </ListView>
                        <Border Width="34" HorizontalAlignment="Right" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="{ThemeResource MuralisScrimTransparentColor}" />
                                    <GradientStop Offset="1" Color="{ThemeResource MuralisBackground0Color}" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                </StackPanel>

                <!--  Recently used  -->
                <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.HasRecent, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Margin="0,0,0,4" Style="{StaticResource SectionTitleStyle}" Text="{Binding [Home_RecentlyUsed], Source={StaticResource Loc}}" />
                    <ListView
                        Padding="0,0,48,0"
                        IsItemClickEnabled="True"
                        ItemClick="OnWallpaperItemClick"
                        ItemContainerStyle="{StaticResource WallpaperRowItemContainerStyle}"
                        ItemTemplate="{StaticResource WallpaperRowTemplate}"
                        ItemsSource="{x:Bind ViewModel.RecentlyUsed}"
                        SelectionMode="None"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollMode="Enabled"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollMode="Disabled">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                    </ListView>
                </StackPanel>

                <!--  Quick tiles  -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ui:MuralisButton
                        Padding="{StaticResource MuralisInsetM}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Click="OnFavoritesTileClick"
                        Variant="Secondary">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="40"
                                Height="40"
                                Background="{ThemeResource MuralisSurfaceSelectedBrush}"
                                CornerRadius="{StaticResource MuralisRadiusPill}">
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{ThemeResource MuralisAccentPrimaryBrush}"
                                    Glyph="&#xE734;" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding [Home_QuickFavorites_Title], Source={StaticResource Loc}}" />
                                <TextBlock Style="{StaticResource CardCaptionStyle}" Text="{Binding [Home_QuickFavorites_Description], Source={StaticResource Loc}}" />
                            </StackPanel>
                            <FontIcon
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource MuralisTextSecondaryBrush}"
                                Glyph="&#xE76C;" />
                        </Grid>
                    </ui:MuralisButton>

                    <ui:MuralisButton
                        Grid.Column="1"
                        Padding="{StaticResource MuralisInsetM}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Click="OnLibraryTileClick"
                        Variant="Secondary">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="40"
                                Height="40"
                                Background="{ThemeResource MuralisSurfaceSelectedBrush}"
                                CornerRadius="{StaticResource MuralisRadiusPill}">
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{ThemeResource MuralisAccentPrimaryBrush}"
                                    Glyph="&#xE8B9;" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding [Home_QuickLibrary_Title], Source={StaticResource Loc}}" />
                                <TextBlock Style="{StaticResource CardCaptionStyle}" Text="{Binding [Home_QuickLibrary_Description], Source={StaticResource Loc}}" />
                            </StackPanel>
                            <FontIcon
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource MuralisTextSecondaryBrush}"
                                Glyph="&#xE76C;" />
                        </Grid>
                    </ui:MuralisButton>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <ProgressRing
            Width="44"
            Height="44"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{x:Bind ViewModel.IsInitialLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsInitialLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</Page>
