<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Muralis.App.Views.DynamicWallpaperPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Muralis.App.ViewModels"
    Background="Transparent"
    mc:Ignorable="d">

    <ScrollViewer Padding="36,24,36,40" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="880"
            HorizontalAlignment="Left"
            Spacing="10">

            <StackPanel Margin="0,0,0,8">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="{Binding [Dynamic_Title], Source={StaticResource Loc}}" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="{Binding [Dynamic_Subtitle], Source={StaticResource Loc}}" />
            </StackPanel>

            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}"
                Severity="Success"
                Visibility="{x:Bind ViewModel.SuccessMessage, Mode=OneWay, Converter={StaticResource NullToVisibility}}" />
            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error"
                Title="{Binding [Common_Error_Title], Source={StaticResource Loc}}"
                Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVisibility}}" />

            <!--  Video  -->
            <TextBlock
                Margin="0,14,0,4"
                Style="{StaticResource SectionTitleStyle}"
                Text="{Binding [Dynamic_Section_Video], Source={StaticResource Loc}}" />
            <Border Padding="16" Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="20"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE714;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding [Dynamic_Video_Title], Source={StaticResource Loc}}" />
                        <TextBlock
                            Style="{StaticResource CardCaptionStyle}"
                            Text="{Binding [Dynamic_Video_Description], Source={StaticResource Loc}}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.VideoFileName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.ChooseVideoCommand}"
                        Content="{Binding [Dynamic_ChooseVideo], Source={StaticResource Loc}}" />
                </Grid>
            </Border>

            <!--  Playback  -->
            <TextBlock
                Margin="0,14,0,4"
                Style="{StaticResource SectionTitleStyle}"
                Text="{Binding [Dynamic_Section_Playback], Source={StaticResource Loc}}" />
            <Border Padding="16" Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="20"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE768;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding [Dynamic_Playback_Title], Source={StaticResource Loc}}" />
                        <TextBlock
                            Style="{StaticResource CardCaptionStyle}"
                            Text="{x:Bind ViewModel.StateText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <Button
                            Command="{x:Bind ViewModel.PlayCommand}"
                            Content="{Binding [Dynamic_Play], Source={StaticResource Loc}}"
                            IsEnabled="{x:Bind ViewModel.CanPlay, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            Command="{x:Bind ViewModel.StopCommand}"
                            Content="{Binding [Dynamic_Stop], Source={StaticResource Loc}}"
                            IsEnabled="{x:Bind ViewModel.CanStop, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Options  -->
            <TextBlock
                Margin="0,14,0,4"
                Style="{StaticResource SectionTitleStyle}"
                Text="{Binding [Dynamic_Section_Options], Source={StaticResource Loc}}" />
            <Border Padding="16" Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="20"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE74F;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding [Dynamic_Mute_Title], Source={StaticResource Loc}}" />
                        <TextBlock Style="{StaticResource CardCaptionStyle}" Text="{Binding [Dynamic_Mute_Description], Source={StaticResource Loc}}" />
                    </StackPanel>
                    <ToggleSwitch
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{Binding [Dynamic_Mute_Title], Source={StaticResource Loc}}"
                        IsOn="{x:Bind ViewModel.Muted, Mode=TwoWay}"
                        OffContent="{Binding [Common_Off], Source={StaticResource Loc}}"
                        OnContent="{Binding [Common_On], Source={StaticResource Loc}}" />
                </Grid>
            </Border>
            <Border Padding="16" Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="20"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE7E8;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding [Dynamic_StartWithApp_Title], Source={StaticResource Loc}}" />
                        <TextBlock Style="{StaticResource CardCaptionStyle}" Text="{Binding [Dynamic_StartWithApp_Description], Source={StaticResource Loc}}" />
                    </StackPanel>
                    <ToggleSwitch
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{Binding [Dynamic_StartWithApp_Title], Source={StaticResource Loc}}"
                        IsOn="{x:Bind ViewModel.StartWithApp, Mode=TwoWay}"
                        OffContent="{Binding [Common_Off], Source={StaticResource Loc}}"
                        OnContent="{Binding [Common_On], Source={StaticResource Loc}}" />
                </Grid>
            </Border>

            <!--  Desktop mode: Windows' own, the canvas over it, or a takeover  -->
            <TextBlock
                Margin="0,14,0,4"
                Style="{StaticResource SectionTitleStyle}"
                Text="{Binding [Dynamic_Section_Desktop], Source={StaticResource Loc}}" />
            <Border Padding="16" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding [Dynamic_Desktop_Title], Source={StaticResource Loc}}" />
                        <TextBlock
                            Style="{StaticResource CardCaptionStyle}"
                            Text="{Binding [Dynamic_Desktop_Description], Source={StaticResource Loc}}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox
                        MinWidth="300"
                        HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="DesktopModeSelector"
                        AutomationProperties.Name="{Binding [Dynamic_Desktop_Mode], Source={StaticResource Loc}}"
                        Header="{Binding [Dynamic_Desktop_Mode], Source={StaticResource Loc}}"
                        IsEnabled="{x:Bind ViewModel.CanToggleCanvas, Mode=OneWay}"
                        ItemsSource="{x:Bind ViewModel.Modes}"
                        SelectedIndex="{x:Bind ViewModel.ModeIndex, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DesktopModeRow">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind Label}" />
                                    <TextBlock
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Description}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock
                        AutomationProperties.AutomationId="DesktopModeState"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.DesktopStateText, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <InfoBar
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.NeedsDesktopRecovery, Mode=OneWay}"
                        Message="{Binding [Dynamic_Desktop_Recovery_Message], Source={StaticResource Loc}}"
                        Severity="Warning"
                        Title="{Binding [Dynamic_Desktop_Recovery_Title], Source={StaticResource Loc}}">
                        <InfoBar.ActionButton>
                            <Button
                                AutomationProperties.AutomationId="RestoreWindowsDesktop"
                                Command="{x:Bind ViewModel.RestoreWindowsDesktopCommand}"
                                Content="{Binding [Dynamic_Desktop_Restore], Source={StaticResource Loc}}" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                </StackPanel>
            </Border>
            <Expander
                Margin="0,8,0,0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                IsExpanded="{x:Bind ViewModel.IsDiagnosticsOpen, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.IsDiagnosticsAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Expander.Header>
                    <TextBlock Text="{Binding [Dynamic_Canvas_Diagnostics_Title], Source={StaticResource Loc}}" />
                </Expander.Header>
                <TextBlock
                    FontFamily="Consolas"
                    FontSize="12"
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind ViewModel.DiagnosticsText, Mode=OneWay}" />
            </Expander>

            <!--  Edge dock  -->
            <TextBlock
                Margin="0,14,0,4"
                Style="{StaticResource SectionTitleStyle}"
                Text="{Binding [Dynamic_Section_Dock], Source={StaticResource Loc}}" />
            <Border Padding="16" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding [Dynamic_Dock_Title], Source={StaticResource Loc}}" />
                        <TextBlock
                            Style="{StaticResource CardCaptionStyle}"
                            Text="{Binding [Dynamic_Dock_Description], Source={StaticResource Loc}}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ToggleSwitch
                            HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="CanvasDockEnabled"
                            AutomationProperties.Name="{Binding [Dynamic_Dock_Enabled], Source={StaticResource Loc}}"
                            Header="{Binding [Dynamic_Dock_Enabled], Source={StaticResource Loc}}"
                            IsEnabled="{x:Bind ViewModel.CanEditCanvasItems, Mode=OneWay}"
                            IsOn="{x:Bind ViewModel.DockEnabled, Mode=TwoWay}"
                            OffContent="{Binding [Common_Off], Source={StaticResource Loc}}"
                            OnContent="{Binding [Common_On], Source={StaticResource Loc}}" />
                        <ToggleSwitch
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="CanvasDockAutoHide"
                            AutomationProperties.Name="{Binding [Dynamic_Dock_AutoHide], Source={StaticResource Loc}}"
                            Header="{Binding [Dynamic_Dock_AutoHide], Source={StaticResource Loc}}"
                            IsEnabled="{x:Bind ViewModel.CanEditCanvasItems, Mode=OneWay}"
                            IsOn="{x:Bind ViewModel.DockAutoHide, Mode=TwoWay}"
                            OffContent="{Binding [Common_Off], Source={StaticResource Loc}}"
                            OnContent="{Binding [Common_On], Source={StaticResource Loc}}" />
                    </Grid>
                    <ComboBox
                        MinWidth="180"
                        HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="CanvasDockEdge"
                        AutomationProperties.Name="{Binding [Dynamic_Dock_Edge], Source={StaticResource Loc}}"
                        DisplayMemberPath="Label"
                        Header="{Binding [Dynamic_Dock_Edge], Source={StaticResource Loc}}"
                        IsEnabled="{x:Bind ViewModel.CanEditCanvasItems, Mode=OneWay}"
                        ItemsSource="{x:Bind ViewModel.DockEdges}"
                        SelectedIndex="{x:Bind ViewModel.DockEdgeIndex, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!--  Desktop items: the programs, shortcuts, folders and addresses on the canvas  -->
            <TextBlock
                Margin="0,14,0,4"
                Style="{StaticResource SectionTitleStyle}"
                Text="{Binding [Dynamic_Section_Canvas_Items], Source={StaticResource Loc}}" />
            <Border Padding="16" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding [Dynamic_Canvas_Items_Title], Source={StaticResource Loc}}" />
                        <TextBlock
                            Style="{StaticResource CardCaptionStyle}"
                            Text="{Binding [Dynamic_Canvas_Items_Description], Source={StaticResource Loc}}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            AutomationProperties.AutomationId="CanvasAddApplication"
                            AutomationProperties.Name="{Binding [Dynamic_Canvas_Add_App], Source={StaticResource Loc}}"
                            Command="{x:Bind ViewModel.AddApplicationCommand}"
                            Content="{Binding [Dynamic_Canvas_Add_App], Source={StaticResource Loc}}"
                            IsEnabled="{x:Bind ViewModel.CanEditCanvasItems, Mode=OneWay}" />
                        <Button
                            AutomationProperties.AutomationId="CanvasAddFolder"
                            AutomationProperties.Name="{Binding [Dynamic_Canvas_Add_Folder], Source={StaticResource Loc}}"
                            Command="{x:Bind ViewModel.AddFolderCommand}"
                            Content="{Binding [Dynamic_Canvas_Add_Folder], Source={StaticResource Loc}}"
                            IsEnabled="{x:Bind ViewModel.CanEditCanvasItems, Mode=OneWay}" />
                        <Button
                            AutomationProperties.AutomationId="DesktopRefreshItems"
                            AutomationProperties.Name="{Binding [Dynamic_Desktop_Refresh], Source={StaticResource Loc}}"
                            Command="{x:Bind ViewModel.RefreshDesktopItemsCommand}"
                            Content="{Binding [Dynamic_Desktop_Refresh], Source={StaticResource Loc}}"
                            IsEnabled="{x:Bind ViewModel.CanRefreshItems, Mode=OneWay}"
                            ToolTipService.ToolTip="{Binding [Dynamic_Desktop_Refresh_Hint], Source={StaticResource Loc}}" />
                    </StackPanel>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            AutomationProperties.AutomationId="CanvasUrlBox"
                            AutomationProperties.Name="{Binding [Dynamic_Canvas_Add_Url_Placeholder], Source={StaticResource Loc}}"
                            IsEnabled="{x:Bind ViewModel.CanEditCanvasItems, Mode=OneWay}"
                            PlaceholderText="{Binding [Dynamic_Canvas_Add_Url_Placeholder], Source={StaticResource Loc}}"
                            Text="{x:Bind ViewModel.NewItemUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Column="1"
                            AutomationProperties.AutomationId="CanvasAddUrl"
                            AutomationProperties.Name="{Binding [Dynamic_Canvas_Add_Url], Source={StaticResource Loc}}"
                            Command="{x:Bind ViewModel.AddUrlCommand}"
                            Content="{Binding [Dynamic_Canvas_Add_Url], Source={StaticResource Loc}}"
                            IsEnabled="{x:Bind ViewModel.CanEditCanvasItems, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock
                Margin="0,10,0,0"
                Style="{StaticResource CardCaptionStyle}"
                Text="{Binding [Dynamic_Canvas_Items_Empty], Source={StaticResource Loc}}"
                Visibility="{x:Bind ViewModel.HasCanvasItems, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
            <ItemsControl
                Margin="0,10,0,0"
                ItemsSource="{x:Bind ViewModel.CanvasItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DesktopItemRow">
                        <Border
                            Margin="0,0,0,8"
                            Padding="12,10"
                            Style="{StaticResource CardBorderStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="18"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="{x:Bind Glyph}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock
                                        MaxLines="1"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        MaxLines="1"
                                        Style="{StaticResource CardCaptionStyle}"
                                        Text="{x:Bind Location}"
                                        TextTrimming="CharacterEllipsis" />
                                    <Border
                                        Margin="0,2,0,0"
                                        Padding="6,1"
                                        HorizontalAlignment="Left"
                                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                        CornerRadius="4"
                                        Visibility="{x:Bind IsMissing, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            Text="{Binding [Dynamic_Canvas_Item_Missing], Source={StaticResource Loc}}" />
                                    </Border>
                                </StackPanel>
                                <Button
                                    Grid.Column="2"
                                    Padding="8"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="{x:Bind RemoveAutomationId}"
                                    AutomationProperties.Name="{Binding [Dynamic_Canvas_Remove], Source={StaticResource Loc}}"
                                    Command="{x:Bind RemoveCommand}"
                                    ToolTipService.ToolTip="{Binding [Dynamic_Canvas_Remove], Source={StaticResource Loc}}">
                                    <FontIcon FontSize="14" Glyph="&#xE711;" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--  Notes  -->
            <TextBlock
                Margin="0,14,0,4"
                Style="{StaticResource SectionTitleStyle}"
                Text="{Binding [Dynamic_Section_Notes], Source={StaticResource Loc}}" />
            <Border Padding="16" Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="20"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE946;" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource CardCaptionStyle}"
                        Text="{Binding [Dynamic_Notes_Description], Source={StaticResource Loc}}"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
