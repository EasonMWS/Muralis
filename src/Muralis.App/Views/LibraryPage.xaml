<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Muralis.App.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Muralis.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Muralis.Core.Models"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="WallpaperGridTemplate" x:DataType="models:Wallpaper">
            <controls:WallpaperCard Wallpaper="{x:Bind}" />
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="36,24,36,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="{Binding [Library_Title], Source={StaticResource Loc}}" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="{Binding [Library_Subtitle], Source={StaticResource Loc}}" />
            </StackPanel>
            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.Name="{Binding [Library_Import], Source={StaticResource Loc}}"
                Click="OnImportClick"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon FontSize="16" Glyph="&#xE710;" />
                    <TextBlock Text="{Binding [Library_Import], Source={StaticResource Loc}}" />
                </StackPanel>
            </Button>
        </Grid>

        <StackPanel
            Grid.Row="1"
            Margin="0,16,0,0"
            Spacing="8">
            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind ViewModel.SuccessNotice, Mode=OneWay}"
                Severity="Success"
                Visibility="{x:Bind ViewModel.SuccessNotice, Mode=OneWay, Converter={StaticResource NullToVisibility}}" />
            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind ViewModel.ErrorNotice, Mode=OneWay}"
                Severity="Error"
                Title="{Binding [Library_Error_Title], Source={StaticResource Loc}}"
                Visibility="{x:Bind ViewModel.ErrorNotice, Mode=OneWay, Converter={StaticResource NullToVisibility}}" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <GridView
                Padding="0"
                IsItemClickEnabled="True"
                ItemClick="OnWallpaperItemClick"
                ItemContainerStyle="{StaticResource WallpaperItemContainerStyle}"
                ItemTemplate="{StaticResource WallpaperGridTemplate}"
                ItemsSource="{x:Bind ViewModel.Items}"
                SelectionMode="None">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid
                            ItemHeight="165"
                            ItemWidth="284"
                            Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
            </GridView>

            <controls:EmptyState
                ActionCommand="{x:Bind ViewModel.ImportCommand}"
                ActionText="{Binding [Library_Import], Source={StaticResource Loc}}"
                Description="{Binding [Library_Empty_Description], Source={StaticResource Loc}}"
                Glyph="&#xE8B9;"
                Title="{Binding [Library_Empty_Title], Source={StaticResource Loc}}"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

            <ProgressRing
                Width="44"
                Height="44"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </Grid>
</Page>
