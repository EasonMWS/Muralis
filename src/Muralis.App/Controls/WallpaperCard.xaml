<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Muralis.App.Controls.WallpaperCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        x:Name="MotionRoot"
        BorderBrush="{ThemeResource MuralisBorderNormalBrush}"
        BorderThickness="1"
        Background="{x:Bind Wallpaper.Id, Mode=OneWay, Converter={StaticResource IdToPlaceholderBrush}}"
        CornerRadius="{StaticResource MuralisRadiusS}"
        Shadow="{StaticResource MuralisElevation2Shadow}">
        <Grid>
            <Image
                x:Name="PreviewImage"
                Source="{x:Bind Wallpaper.DisplayImagePath, Mode=OneWay, Converter={StaticResource PathToImageSource}}"
                Stretch="UniformToFill" />

            <!--  Bottom scrim so the title stays readable on any image  -->
            <Border Height="78" VerticalAlignment="Bottom" CornerRadius="0,0,12,12">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="{ThemeResource MuralisScrimTransparentColor}" />
                        <GradientStop Offset="0.58" Color="{ThemeResource MuralisScrimMediumColor}" />
                        <GradientStop Offset="1" Color="{ThemeResource MuralisScrimStrongColor}" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Border
                Height="1"
                Margin="14,0"
                VerticalAlignment="Top"
                Background="{ThemeResource MuralisEdgeHighlightMediumBrush}"
                CornerRadius="{StaticResource MuralisRadiusPill}"
                IsHitTestVisible="False" />

            <!--  Favorite badge  -->
            <Border
                Margin="{StaticResource MuralisInsetXS}"
                Padding="{StaticResource MuralisInsetXXS}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="{ThemeResource MuralisSurfaceHighBrush}"
                BorderBrush="{ThemeResource MuralisBorderNormalBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource MuralisRadiusPill}"
                Visibility="{x:Bind Wallpaper.IsFavorite, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <FontIcon
                    FontSize="12"
                    Foreground="{ThemeResource MuralisAccentPrimaryBrush}"
                    Glyph="&#xEB51;" />
            </Border>

            <Border
                x:Name="SelectionIndicator"
                Width="24"
                Height="3"
                Margin="{StaticResource MuralisInsetXS}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{ThemeResource MuralisAccentPrimaryBrush}"
                CornerRadius="{StaticResource MuralisRadiusPill}"
                Opacity="0" />

            <StackPanel
                Margin="12,0,12,12"
                VerticalAlignment="Bottom"
                Spacing="1">
                <TextBlock
                    Style="{StaticResource MuralisBodyTextStyle}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource MuralisOnImagePrimaryBrush}"
                    Text="{x:Bind Wallpaper.Title, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Style="{StaticResource MuralisCaptionTextStyle}"
                    Foreground="{ThemeResource MuralisOnImageSecondaryBrush}"
                    Text="{x:Bind Wallpaper.MetaText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
