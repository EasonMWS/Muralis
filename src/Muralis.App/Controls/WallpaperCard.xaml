<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Muralis.App.Controls.WallpaperCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        Background="{x:Bind Wallpaper.Id, Mode=OneWay, Converter={StaticResource IdToPlaceholderBrush}}"
        CornerRadius="8">
        <Grid>
            <Image
                Source="{x:Bind Wallpaper.DisplayImagePath, Mode=OneWay, Converter={StaticResource PathToImageSource}}"
                Stretch="UniformToFill" />

            <!--  Bottom scrim so the title stays readable on any image  -->
            <Border Height="84" VerticalAlignment="Bottom" CornerRadius="0,0,8,8">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#00000000" />
                        <GradientStop Offset="0.5" Color="#8C000000" />
                        <GradientStop Offset="1" Color="#D9000000" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!--  Favorite badge  -->
            <Border
                Margin="8"
                Padding="5"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="#66000000"
                CornerRadius="12"
                Visibility="{x:Bind Wallpaper.IsFavorite, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <FontIcon
                    FontSize="11"
                    Foreground="#FFFF6B81"
                    Glyph="&#xEB51;" />
            </Border>

            <StackPanel
                Margin="12,0,12,10"
                VerticalAlignment="Bottom"
                Spacing="1">
                <TextBlock
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="{x:Bind Wallpaper.Title, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    FontSize="12"
                    Foreground="#B3FFFFFF"
                    Text="{x:Bind Wallpaper.MetaText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
