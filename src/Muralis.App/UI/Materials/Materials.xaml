<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materials="using:Muralis.App.UI.Materials">

    <Style x:Key="MuralisGlassSurfaceBaseStyle" TargetType="materials:GlassSurface">
        <Setter Property="Padding" Value="{StaticResource MuralisInsetM}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource MuralisRadiusM}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="materials:GlassSurface">
                    <Grid>
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <Border
                            Height="1"
                            Margin="14,0"
                            VerticalAlignment="Top"
                            Background="{TemplateBinding HighlightBrush}"
                            CornerRadius="{StaticResource MuralisRadiusPill}"
                            IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MuralisGlassLowStyle" TargetType="materials:GlassSurface" BasedOn="{StaticResource MuralisGlassSurfaceBaseStyle}">
        <Setter Property="Background" Value="{ThemeResource MuralisGlassLowBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource MuralisBorderSubtleBrush}" />
        <Setter Property="HighlightBrush" Value="{ThemeResource MuralisEdgeHighlightLowBrush}" />
        <Setter Property="Shadow" Value="{StaticResource MuralisElevation1Shadow}" />
    </Style>
    <Style x:Key="MuralisGlassMediumStyle" TargetType="materials:GlassSurface" BasedOn="{StaticResource MuralisGlassSurfaceBaseStyle}">
        <Setter Property="Background" Value="{ThemeResource MuralisGlassMediumBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource MuralisBorderNormalBrush}" />
        <Setter Property="HighlightBrush" Value="{ThemeResource MuralisEdgeHighlightMediumBrush}" />
        <Setter Property="Shadow" Value="{StaticResource MuralisElevation2Shadow}" />
    </Style>
    <Style x:Key="MuralisGlassHighStyle" TargetType="materials:GlassSurface" BasedOn="{StaticResource MuralisGlassSurfaceBaseStyle}">
        <Setter Property="Background" Value="{ThemeResource MuralisGlassHighBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource MuralisBorderHoverBrush}" />
        <Setter Property="HighlightBrush" Value="{ThemeResource MuralisEdgeHighlightHighBrush}" />
        <Setter Property="Shadow" Value="{StaticResource MuralisElevation3Shadow}" />
    </Style>

    <!-- Border counterparts make incremental migration possible without wrapping existing pages. -->
    <Style x:Key="MuralisGlassLowBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource MuralisGlassLowBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource MuralisBorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource MuralisRadiusS}" />
        <Setter Property="Shadow" Value="{StaticResource MuralisElevation1Shadow}" />
    </Style>
    <Style x:Key="MuralisGlassMediumBorderStyle" TargetType="Border" BasedOn="{StaticResource MuralisGlassLowBorderStyle}">
        <Setter Property="Background" Value="{ThemeResource MuralisGlassMediumBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource MuralisRadiusM}" />
        <Setter Property="Shadow" Value="{StaticResource MuralisElevation2Shadow}" />
    </Style>
    <Style x:Key="MuralisGlassHighBorderStyle" TargetType="Border" BasedOn="{StaticResource MuralisGlassLowBorderStyle}">
        <Setter Property="Background" Value="{ThemeResource MuralisGlassHighBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource MuralisBorderHoverBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource MuralisRadiusM}" />
        <Setter Property="Shadow" Value="{StaticResource MuralisElevation3Shadow}" />
    </Style>
</ResourceDictionary>
