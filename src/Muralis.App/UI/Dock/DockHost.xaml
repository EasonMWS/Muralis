<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Muralis.App.UI.Dock.DockHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Muralis.App.UI.Controls"
    xmlns:dock="using:Muralis.App.UI.Dock">

    <!--
        The Muralis Dock: pure transparent, icon-only, bottom-centred, sized to its content.

        Its resting visual output is the pinned app icons and nothing else â€?no dock-wide panel, no
        labels, no separators, no add tile, no utilities, no Shelf. The Desktop Shelf and the utility
        items are live services; they are simply not part of this presentation.

        Everything below is laid out the same way in both background styles, so switching style changes
        only whether a plate is painted and never how the dock is sized, laid out or driven.
    -->
    <Grid>
        <!--
            The motion tracker covers the whole dock window and sits under everything else. It exists so the
            pointer can be followed across the entire window rather than only over the icons: a wave that
            only began once the pointer was already on an icon would have nothing continuous to begin from.
            It is transparent but hit-testable, and it is not in the way of the icons above it, which are
            later in this panel and therefore on top.
        -->
        <Grid
            x:Name="MotionTracker"
            Background="Transparent" />

        <!--
            The dock's own box. Its height is the stripe the motion is drawn in: the room a magnified icon
            grows into, plus the icon box, plus the feet. Fixing the height here rather than inside the
            motion means the icons keep a fixed baseline and the reserve cannot be spent twice.

            In the Transparent style this element paints nothing at all â€?no background, no border, no
            shadow â€?so the wallpaper shows through between, behind and around the icons. The Glass style
            is the same box with a plate painted on it.
        -->
        <Border
            x:Name="DockPlate"
            MinHeight="{x:Bind DockHeight, Mode=OneWay}"
            Padding="12,10"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom">
            <Grid x:Name="PinnedZone" VerticalAlignment="Bottom">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <ItemsControl
                        AutomationProperties.Name="Pinned apps"
                        ItemsSource="{x:Bind PinnedApps.Items, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="dock:PinnedAppViewItem">
                                <controls:DockIcon
                                    AllowDrop="True"
                                    DragOver="OnPinnedDragOver"
                                    Drop="OnPinnedDrop"
                                    IconContent="{x:Bind IconContent, Mode=OneWay}"
                                    IsHighlighted="{x:Bind IsHighlighted, Mode=OneWay}"
                                    IsUnavailable="{x:Bind IsUnavailable, Mode=OneWay}"
                                    Label="{x:Bind DisplayName, Mode=OneWay}"
                                    Loaded="OnDockIconLoaded"
                                    PointerCanceled="OnPinnedPointerCanceled"
                                    PointerCaptureLost="OnPinnedPointerCanceled"
                                    PointerMoved="OnPinnedPointerMoved"
                                    PointerPressed="OnPinnedPointerPressed"
                                    PointerReleased="OnPinnedPointerReleased"
                                    Tag="{x:Bind}"
                                    Tapped="OnPinnedItemTapped"
                                    ToolTipService.ToolTip="{x:Bind Tooltip, Mode=OneWay}">
                                    <controls:DockIcon.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem
                                                Click="OnPinnedOpen"
                                                Tag="{x:Bind}"
                                                Text="{Binding [Dock_Pinned_Open], Source={StaticResource Loc}}" />
                                            <MenuFlyoutItem
                                                Click="OnPinnedOpenLocation"
                                                Tag="{x:Bind}"
                                                Text="{Binding [Dock_Pinned_OpenLocation], Source={StaticResource Loc}}" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem
                                                Click="OnPinnedUnpin"
                                                Tag="{x:Bind}"
                                                Text="{Binding [Dock_Pinned_Unpin], Source={StaticResource Loc}}" />
                                        </MenuFlyout>
                                    </controls:DockIcon.ContextFlyout>
                                </controls:DockIcon>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Border
                    x:Name="PinnedDropIndicator"
                    Width="2"
                    Height="52"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Background="{ThemeResource MuralisAccentPrimaryBrush}"
                    CornerRadius="{StaticResource MuralisRadiusPill}"
                    IsHitTestVisible="False"
                    Opacity="0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
