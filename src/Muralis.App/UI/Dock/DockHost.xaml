<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Muralis.App.UI.Dock.DockHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Muralis.App.UI.Controls"
    xmlns:dock="using:Muralis.App.UI.Dock"
    xmlns:materials="using:Muralis.App.UI.Materials"
    xmlns:shell="using:Muralis.Core.DockShell">

    <materials:GlassSurface
        Padding="14,10"
        HorizontalAlignment="Center"
        Level="Low">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="PinnedZone">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <ItemsControl
                        AutomationProperties.Name="Pinned apps"
                        ItemsSource="{x:Bind PinnedApps.Items, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="dock:PinnedAppViewItem">
                                <controls:DockIcon
                                    AllowDrop="True"
                                    DragOver="OnPinnedDragOver"
                                    Drop="OnPinnedDrop"
                                    IconContent="{x:Bind IconContent, Mode=OneWay}"
                                    IsHighlighted="{x:Bind IsHighlighted, Mode=OneWay}"
                                    IsUnavailable="{x:Bind IsUnavailable, Mode=OneWay}"
                                    Label="{x:Bind DisplayName, Mode=OneWay}"
                                    Loaded="OnDockIconLoaded"
                                    PointerCanceled="OnPinnedPointerCanceled"
                                    PointerCaptureLost="OnPinnedPointerCanceled"
                                    PointerMoved="OnPinnedPointerMoved"
                                    PointerPressed="OnPinnedPointerPressed"
                                    PointerReleased="OnPinnedPointerReleased"
                                    Tag="{x:Bind}"
                                    Tapped="OnPinnedItemTapped"
                                    ToolTipService.ToolTip="{x:Bind Tooltip, Mode=OneWay}">
                                    <controls:DockIcon.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem
                                                Click="OnPinnedOpen"
                                                Tag="{x:Bind}"
                                                Text="{Binding [Dock_Pinned_Open], Source={StaticResource Loc}}" />
                                            <MenuFlyoutItem
                                                Click="OnPinnedOpenLocation"
                                                Tag="{x:Bind}"
                                                Text="{Binding [Dock_Pinned_OpenLocation], Source={StaticResource Loc}}" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem
                                                Click="OnPinnedUnpin"
                                                Tag="{x:Bind}"
                                                Text="{Binding [Dock_Pinned_Unpin], Source={StaticResource Loc}}" />
                                        </MenuFlyout>
                                    </controls:DockIcon.ContextFlyout>
                                </controls:DockIcon>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <controls:DockAddTile
                        x:Name="AddAppTile"
                        Label="{Binding [Dock_Pinned_AddApp], Source={StaticResource Loc}}"
                        ToolTipService.ToolTip="{Binding [Dock_Pinned_Empty], Source={StaticResource Loc}}"
                        AddRequested="OnPinnedAddRequested" />
                </StackPanel>

                <Border
                    x:Name="PinnedDropIndicator"
                    Width="2"
                    Height="52"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="{ThemeResource MuralisAccentPrimaryBrush}"
                    CornerRadius="{StaticResource MuralisRadiusPill}"
                    IsHitTestVisible="False"
                    Opacity="0" />
            </Grid>

            <Border
                Grid.Column="1"
                Margin="0,8"
                Background="{ThemeResource MuralisBorderSubtleBrush}"
                CornerRadius="{StaticResource MuralisRadiusPill}" />

            <ScrollViewer
                x:Name="ShelfScroller"
                Grid.Column="2"
                Width="420"
                MinWidth="220"
                MaxWidth="560"
                AutomationProperties.Name="Desktop Shelf"
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Enabled"
                PointerWheelChanged="OnShelfPointerWheelChanged"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled"
                ZoomMode="Disabled">
                <ItemsControl ItemsSource="{x:Bind ShelfItems, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="dock:DesktopShelfViewItem">
                            <controls:DockIcon
                                DoubleTapped="OnShelfItemDoubleTapped"
                                IconContent="{x:Bind IconContent, Mode=OneWay}"
                                IsSelected="{x:Bind IsSelected, Mode=OneWay}"
                                Label="{x:Bind DisplayName}"
                                Loaded="OnDockIconLoaded"
                                Tapped="OnShelfItemTapped"
                                ToolTipService.ToolTip="{x:Bind DisplayName}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border
                Grid.Column="3"
                Margin="0,8"
                Background="{ThemeResource MuralisBorderSubtleBrush}"
                CornerRadius="{StaticResource MuralisRadiusPill}" />

            <ItemsControl
                Grid.Column="4"
                AutomationProperties.Name="Utilities"
                ItemsSource="{x:Bind UtilityItems, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="shell:DockShellItem">
                        <controls:DockIcon Label="{x:Bind DisplayName}" Loaded="OnDockIconLoaded">
                            <controls:DockIcon.IconContent>
                                <FontIcon FontSize="23" Glyph="{x:Bind Glyph}" />
                            </controls:DockIcon.IconContent>
                        </controls:DockIcon>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </materials:GlassSurface>
</UserControl>
