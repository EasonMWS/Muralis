<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Muralis.App.UI.Controls.DockAddTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Muralis.App.UI.Controls">
    <Grid MinWidth="64" Padding="8" RowSpacing="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4" />
        </Grid.RowDefinitions>

        <Grid Width="52" Height="52" HorizontalAlignment="Center">
            <Border
                Width="48"
                Height="48"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource MuralisGlassLowBrush}"
                BorderBrush="{ThemeResource MuralisBorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource MuralisRadiusS}">
                <controls:MuralisIconButton
                    x:Name="AddButton"
                    Width="48"
                    Height="48"
                    MinHeight="48"
                    Padding="0"
                    AutomationProperties.Name="{x:Bind Label, Mode=OneWay}"
                    Click="OnAddClicked">
                    <FontIcon
                        FontSize="18"
                        Foreground="{ThemeResource MuralisTextSecondaryBrush}"
                        Glyph="&#xE710;" />
                </controls:MuralisIconButton>
            </Border>
        </Grid>

        <TextBlock
            Grid.Row="1"
            MaxWidth="80"
            HorizontalAlignment="Center"
            Foreground="{ThemeResource MuralisTextSecondaryBrush}"
            Style="{StaticResource MuralisCaptionTextStyle}"
            Text="{x:Bind Label, Mode=OneWay}"
            TextAlignment="Center"
            TextTrimming="CharacterEllipsis" />
    </Grid>
</UserControl>
