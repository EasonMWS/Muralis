<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Muralis.App.UI.Controls.DockIcon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid
        x:Name="MotionHost"
        MinWidth="64"
        Padding="8"
        RowSpacing="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4" />
        </Grid.RowDefinitions>

        <Grid Width="52" Height="52" HorizontalAlignment="Center">
            <Border
                x:Name="IconSurface"
                Width="48"
                Height="48"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource MuralisGlassLowBrush}"
                BorderBrush="{ThemeResource MuralisBorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource MuralisRadiusS}"
                Shadow="{StaticResource MuralisElevation1Shadow}">
                <Grid>
                    <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="{x:Bind IconContent, Mode=OneWay}" />
                    <Border
                        Height="1"
                        Margin="8,0"
                        VerticalAlignment="Top"
                        Background="{ThemeResource MuralisEdgeHighlightLowBrush}"
                        CornerRadius="{StaticResource MuralisRadiusPill}"
                        IsHitTestVisible="False" />
                </Grid>
            </Border>
            <Border
                x:Name="SelectionIndicator"
                Width="7"
                Height="7"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="{ThemeResource MuralisAccentSecondaryBrush}"
                BorderBrush="{ThemeResource MuralisSurfaceHighBrush}"
                BorderThickness="2"
                CornerRadius="{StaticResource MuralisRadiusPill}"
                Opacity="0" />
            <Border
                x:Name="UnavailableBadge"
                Width="14"
                Height="14"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="{ThemeResource MuralisSurfaceHighBrush}"
                BorderBrush="{ThemeResource MuralisBorderNormalBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource MuralisRadiusPill}"
                IsHitTestVisible="False"
                Opacity="0">
                <FontIcon
                    FontSize="8"
                    Foreground="{ThemeResource MuralisTextSecondaryBrush}"
                    Glyph="&#xE7BA;" />
            </Border>
        </Grid>

        <TextBlock
            x:Name="LabelText"
            Grid.Row="1"
            MaxWidth="80"
            HorizontalAlignment="Center"
            Style="{StaticResource MuralisCaptionTextStyle}"
            Text="{x:Bind Label, Mode=OneWay}"
            TextAlignment="Center"
            TextTrimming="CharacterEllipsis" />

        <Border
            x:Name="RunningIndicator"
            Grid.Row="2"
            Width="16"
            Height="2"
            HorizontalAlignment="Center"
            Background="{ThemeResource MuralisAccentPrimaryBrush}"
            CornerRadius="{StaticResource MuralisRadiusPill}"
            Opacity="0" />
    </Grid>
</UserControl>
