<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="MuralisFontFamily">Segoe UI Variable</FontFamily>

    <Style x:Key="MuralisDisplayTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MuralisFontFamily}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource MuralisTextPrimaryBrush}" />
    </Style>
    <Style x:Key="MuralisTitleLargeTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MuralisFontFamily}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource MuralisTextPrimaryBrush}" />
    </Style>
    <Style x:Key="MuralisTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MuralisFontFamily}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource MuralisTextPrimaryBrush}" />
    </Style>
    <Style x:Key="MuralisBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MuralisFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource MuralisTextPrimaryBrush}" />
    </Style>
    <Style x:Key="MuralisBodySmallTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MuralisFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource MuralisTextSecondaryBrush}" />
    </Style>
    <Style x:Key="MuralisCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MuralisFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource MuralisTextTertiaryBrush}" />
    </Style>
</ResourceDictionary>
